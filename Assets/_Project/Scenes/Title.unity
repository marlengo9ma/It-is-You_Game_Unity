  m_text: "\uAE00\uC790 \uC18D\uB3C4\uB294 \uD3C9\uBC94\uD55C \uB300\uD654\uC5D0\uB9CC
    \uC801\uC6A9\uB429\uB2C8\uB2E4. \uC2EC\uBB38 \uC911\uC758 \uB9D0\uD558\uB294
    \uC18D\uB3C4\uB294 \uC5F0\uCD9C\uC774\uB77C \uACE0\uC815\uC785\uB2C8\uB2E4.\n\uC790\uB3D9
    \uB118\uAE40 \uC18D\uB3C4\uB294 AUTO \uB97C \uCF30\uC744 \uB54C \uD55C \uC904\uC774
    \uB2E4 \uB098\uC628 \uB4A4 \uB2E4\uC74C \uC904\uAE4C\uC9C0 \uAE30\uB2E4\uB9AC\uB294
    \uC2DC\uAC04\uC785\uB2C8\uB2E4.\n\uAC00\uC774\uB4DC \uBAA8\uB4DC\uB294 \uBB34\uBC18\uC751
    \uD310\uC815\uC744 \uC2DC\uAC04 \uCC28\uAC10 \uB300\uC2E0 \uC120\uD0DD\uC9C0\uB85C
    \uBC14\uAFB8\uB294 \uBAA8\uB4DC\uB85C, \uC544\uC9C1 \uAE30\uD68D \uC911\uC785\uB2C8\uB2E4."
