          clueId: 
          openDelay: 0
          window: 2.5
          expression: 3
          blurredFromRecallDepth: 2
        autoGrantClueId: 
      - speaker: 3
        text: "\uC815\uB9D0\uC774\uC5D0\uC694!\u2026 \uC5B4\uB5A4 \uAC83 \uB54C\uBB38\uC5D0
          \uC81C\uAC00 \uC758\uC2EC\uBC1B\uB294\uAC74\uC9C0\uB294 \uBAA8\uB974\uACA0\uC5B4\uC694."
