        animationId: 
        reaction:
          clueId: 
          openDelay: 0
          window: 2.5
          expression: 3
          blurredFromRecallDepth: 2
        autoGrantClueId: 
      - speaker: 3
        text: "\uC81C\uAC00 \uB9CC\uB144\uD544\uC744 \uAC00\uC838\uAC08 \uC774\uC720\uB3C4,
          \uB9CC\uC57D\uC5D0\uB77C\uB3C4 \uD589\uBC29\uC744 \uC54C\uACE0 \uC788\uB2E4\uBA74\u2026"
        expression: 5
        stageDirection: 
        animationId: 
        reaction:
          clueId: 
          openDelay: 0
          window: 2.5
          expression: 3
          blurredFromRecallDepth: 2
        autoGrantClueId: 
      - speaker: 3
        text: "\uAD73\uC774 \uC228\uAE38 \uC774\uC720\uB3C4 \uC5C6\uB294\uAC78\uC694."
        expression: 5
        stageDirection: 
        animationId: 
        reaction:
          clueId: 
          openDelay: 0
          window: 2.5
          expression: 3
          blurredFromRecallDepth: 2
        autoGrantClueId: 
      - speaker: 1
        text: "\uADF8\uB798\uB3C4 \uC608\uC0C1\uC774 \uAC00\uB294 \uC774\uC720\uAC00
          \uC788\uAE30 \uB54C\uBB38\uC5D0 \uC228\uAE30\uB294 \uAC70 \uC544\uB2D9\uB2C8\uAE4C!"
