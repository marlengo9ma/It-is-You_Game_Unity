  id: CH_SEPI_AGGRESSIVE
  tone: 1
  label: "\uC544\uBB34\uB9AC \uADF8\uB798\uB3C4 \uADF8\uB807\uC9C0 \uC0C1\uC0AC\uC758
    \uBB3C\uAC74\uC744 \uD6D4\uCE58\uB2E4\uB2C8, \uCD08\uBA74\uBD80\uD130 \uC801\uC796\uC774
