          blurredFromRecallDepth: 2
        autoGrantClueId: 
      - speaker: 1
        text: "\uD558\uB2E4\uBABB\uD574 \uC228\uAE30\uB294 \uAC83\uC5D0 \uB300\uD574\uC11C
          \uB9D0\uC744 \uBABB\uD558\uB294 \uC774\uC720\uAC00 \uBB50\uC8E0?"
        expression: 0
        stageDirection: 
        animationId: 
