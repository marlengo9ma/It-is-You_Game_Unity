  passes:
  - note: "C \uCD08\uD68C \u2014 \uACE0\uC591\uC774 \uB2E8\uC5B4\uC5D0\uC11C \uAD73\uB294\uB2E4"
    labelOverride: "\uC774 \uB9AC\uBCF8\uC740 \uBD84\uBA85 \uAE30\uCC28\uC5ED\uC5D0
      \uB450\uACE0 \uC654\uB358 \uAC70 \uAC19\uC740\uB370 \uD0C0\uC790\uAE30\uB791
      \uAC19\uC774 \uCC59\uACA8\uC654\uC5C8\uB098 \uBCF4\uAD70\uC694?"
    sequence:
      note: "C \uCD08\uD68C \u2014 \uACE0\uC591\uC774 \uB2E8\uC5B4\uC5D0\uC11C \uAD73\uB294\uB2E4"
      lines:
      - speaker: 1
        text: "\uC774 \uB9AC\uBCF8\uC740 \uBD84\uBA85 \uAE30\uCC28\uC5ED\uC5D0 \uB450\uACE0
          \uC654\uB358 \uAC70 \uAC19\uC740\uB370 \uD0C0\uC790\uAE30\uB791 \uAC19\uC774
          \uCC59\uACA8\uC654\uC5C8\uB098 \uBCF4\uAD70\uC694?"
        expression: 0
        stageDirection: 
        animationId: 
        reaction:
          clueId: 
          openDelay: 0
          window: 2.5
          expression: 3
          blurredFromRecallDepth: 2
        autoGrantClueId: 
      - speaker: 3
        text: "\uC557, \uB124! \uC218\uC0AC\uAD00\uB2D8\uAED8\uC11C \uAD6C\uB9E4\uD558\uC168\uB358
          \uAC83 \uC544\uB2CC\uAC00\uC694?"
        expression: 1
        stageDirection: "(\uAC11\uC791\uC2A4\uB7EC\uC6B4 \uC8FC\uC81C \uC804\uD658\uC5D0
          \uC870\uAE08 \uB2F9\uD669\uD55C \uB4EF \uD588\uC9C0\uB9CC)"
        animationId: 
        reaction:
          clueId: 
          openDelay: 0
          window: 2.5
          expression: 3
          blurredFromRecallDepth: 2
        autoGrantClueId: 
      - speaker: 3
        text: "\uD5C9 \uD639\uC2DC \uC800\uD76C \uC9D0\uC774 \uC544\uB2C8\uC600\uB098\uC694?!
          \uB204\uAD70\uAC00\uC758 \uC18C\uC911\uD55C \uB9AC\uBCF8\uC774\uC5C8\uB2E4\uB358
          \uAC74\u2026 \uC774\uBBF8 \uAE30\uCC28\uB294 \uCD9C\uBC1C\uD574 \uBC84\uB838\uB294\uB370
          \uC5B4\uB5BB\uAC8C \uD558\uC8E0, \uC218\uC0AC\uAD00\uB2D8?"
        expression: 6
        stageDirection: "(\uBBF8\uCC98 \uC0DD\uAC01 \uBABB\uD55C \uBD80\uBD84\uC774
          \uC0DD\uAC01\uB09C \uB4EF, \uC0B4\uC9DD \uB180\uB77C\uBA70)"
        animationId: startle
        reaction:
          clueId: 
          openDelay: 0
          window: 2.5
          expression: 3
          blurredFromRecallDepth: 2
        autoGrantClueId: 
      - speaker: 1
        text: "\u2026\uC81C\uAC00 \uAD6C\uB9E4\uD55C \uAC8C \uB9DE\uC73C\uB2C8 \uADF8\uAC74
          \uAC71\uC815\uD558\uC9C0 \uC54A\uC73C\uC154\uB3C4 \uAD1C\uCC2E\uC2B5\uB2C8\uB2E4."
        expression: 0
        stageDirection: 
        animationId: 
        reaction:
          clueId: 
          openDelay: 0
          window: 2.5
          expression: 3
          blurredFromRecallDepth: 2
        autoGrantClueId: 
      - speaker: 3
        text: "\uADF8\uB807\uB2E4\uBA74 \uB2E4\uD589\uC774\uB124\uC694! \uADF8\uAC74
          \uADF8\uB807\uACE0 \uC774\uB807\uAC8C \uBA4B\uC9C4 \uB9AC\uBCF8\uC744 \uAE4C\uBA39\uACE0
          \uB450\uACE0\uAC00\uC2DC\uB2E4\uB2C8, \uC81C\uAC00 \uC548 \uAC00\uC838\uC654\uC73C\uBA74
          \uC5B4\uCA54 \uBED4 \uD588\uC5B4\uC694?"
        expression: 1
        stageDirection: "(\uB2F9\uC2E0\uC758 \uB9D0\uC5D0 \uC548\uC2EC\uD55C \uB4EF
          \uD558\uB2E4\uAC00, \uC7A5\uB09C\uC2A4\uB7EC\uC6B4 \uD45C\uC815\uC73C\uB85C)"
        animationId: 
        reaction:
          clueId: 
          openDelay: 0
          window: 2.5
          expression: 3
          blurredFromRecallDepth: 2
        autoGrantClueId: 
      - speaker: 1
        text: "\u2026\uACE0\uC591\uC774 \uD138\uB3C4 \uBD99\uC5B4 \uC788\uACE0 \uCEE4\uD53C
          \uC790\uAD6D\uB3C4 \uADF8\uB807\uACE0. \uBA4B\uC9C4 \uB9AC\uBCF8\uC774\uB77C\uAE30\uC5D4
          \uC774\uC81C\uB294 \uC870\uAE08 \uC544\uC26C\uC6CC\uC84C\uAD70\uC694."
        expression: 0
        stageDirection: 
        animationId: 
        reaction:
          clueId: 
          openDelay: 0
          window: 2.5
          expression: 3
          blurredFromRecallDepth: 2
        autoGrantClueId: 
      - speaker: 3
        text: "\uADF8,\uADF8\uB7EC\uAC8C\uC694. \uD558,\uD558\uD56B\u2026"
        expression: 3
        stageDirection: "(\uB2F9\uC2E0\uC758 \uACE0\uC591\uC774\uB77C\uB294 \uB2E8\uC5B4\uC5D0
          \uB300\uD55C \uBC18\uC751\uC73C\uB85C \uB2E4\uC18C \uBE44\uC774\uC0C1\uC801\uC778
          \uB2F9\uD639\uAC10\uC744 \uBCF4\uC5EC\uC8FC\uBA70) (\uACB0\uAD6D \uC2DC\uC120\uC744
          \uD53C\uD558\uBA70 \uC5BC\uBA38\uBB34\uB9B0\uB2E4)"
        animationId: lookaway
        reaction:
          clueId: REA_CAT_FLINCH
          openDelay: 0.35
          window: 2.6
          expression: 3
          blurredFromRecallDepth: 2
        autoGrantClueId: 
      - speaker: 2
        text: "\uACE0\uC591\uC774 \uB54C\uBB38\uC5D0 \uC624\uC5FC\uB41C \uAC83\uC740
          \uD655\uC2E4\uD574 \uBCF4\uC774\uB294\uAD70. \uADF8\uB7F0\uB370\u2026 \uB9C8\uCE58
          \uB2E4\uB978 \uC774\uC720\uB77C\uB3C4 \uC788\uB294 \uB4EF\uD55C \uBC18\uC751\uC778\uAC78."
        expression: 0
        stageDirection: 
        animationId: 
        reaction:
          clueId: 
          openDelay: 0
          window: 2.5
          expression: 3
          blurredFromRecallDepth: 2
        autoGrantClueId: 
