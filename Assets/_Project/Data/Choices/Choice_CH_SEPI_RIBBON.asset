  id: CH_SEPI_RIBBON
  tone: 2
  label: "\uC774 \uB9AC\uBCF8\uC740 \uBD84\uBA85 \uAE30\uCC28\uC5ED\uC5D0 \uB450\uACE0
    \uC654\uB358 \uAC70 \uAC19\uC740\uB370 \uD0C0\uC790\uAE30\uB791 \uAC19\uC774
    \uCC59\uACA8\uC654\uC5C8\uB098 \uBCF4\uAD70\uC694?"
  labelWhenInformed: 
  labelSwapClueIds: []
  availableFromStart: 1
