          expression: 3
          blurredFromRecallDepth: 2
        autoGrantClueId: 
      - speaker: 3
        text: "\uADF8,\uADF8\uB7AC\uB358 \uAC83 \uAC19\uC544\uC694. \uC544\uB9C8\uB3C4
          \uBD99\uC7A1\uACE0, \uBB3C\uACE0, \uC2E0\uB098\uC11C \uC5EC\uAE30\uC800\uAE30
          \uB2E4\uB154\uB358 \uAC83 \uAC19\uC740\uB370\uC694?"
        expression: 2
        stageDirection: "(\uC2DC\uC120\uC744 \uD53C\uD558\uC9C0\uB9CC \uB044\uB355\uC774\uBA70)"
        animationId: lookaway
        reaction:
          clueId: 
          openDelay: 0
          window: 2.5
          expression: 3
          blurredFromRecallDepth: 2
        autoGrantClueId: 
      animationId: 
      trustDelta: 0
      endsInterrogation: 0
