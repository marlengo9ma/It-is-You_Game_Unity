  - note: "C 2\uD68C"
    labelOverride: "\uACE0\uC591\uC774\uAC00 \uBB3C\uACE0 \uB2E4\uB2C8\uAE30\uB77C\uB3C4
      \uD588\uB098 \uBCF4\uAD70\uC694? \uC774\uB9AC \uC5BC\uB8E9\uC9C0\uACE0 \uD138\uB4E4\uC774
      \uBD99\uC740\uAC78 \uBCF4\uB2C8."
