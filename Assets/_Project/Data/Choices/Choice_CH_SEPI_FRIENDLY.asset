        expression: 4
        stageDirection: 
        animationId: 
        reaction:
          clueId: 
          openDelay: 0
          window: 2.5
          expression: 3
          blurredFromRecallDepth: 2
        autoGrantClueId: 
      - speaker: 3
        text: "\uB3D9\uB8CC\uB85C\uC11C \uB108\uBB34\uD558\uC2E0 \uAC70 \uC544\uB2CC\uAC00\uC694?"
