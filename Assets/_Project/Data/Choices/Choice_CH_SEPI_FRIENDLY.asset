          \uC544\uB294 \uAC8C \uC788\uB2E4\uBA74 \uAF2D \uC54C\uB824\uC8FC\uC5C8\uC74C
          \uD569\uB2C8\uB2E4."
        expression: 0
        stageDirection: 
        animationId: 
        reaction:
          clueId: 
          openDelay: 0
          window: 2.5
          expression: 3
          blurredFromRecallDepth: 2
        autoGrantClueId: 
      - speaker: 3
        text: "\u2026\uCC98\uC74C \uC790\uB9AC\uC5D0 \uC549\uC73C\uC168\uC744 \uB54C\uB294\u2026
          <clue=TES_SAW_IT>\uBD84\uBA85\uD788 \uC800\uB3C4 \uBD24\uB358 \uAC83 \uAC19\uAE34
          \uD55C\uB370\uC694.</clue>"
