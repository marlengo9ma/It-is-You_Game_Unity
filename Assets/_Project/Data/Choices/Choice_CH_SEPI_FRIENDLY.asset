        animationId: 
        reaction:
          clueId: 
          openDelay: 0
          window: 2.5
          expression: 3
          blurredFromRecallDepth: 2
        autoGrantClueId: 
      - speaker: 3
        text: "\uD558\uC9C0\uB9CC \uADF8\uAC83\uACFC \uBCC4\uAC1C\uB85C \uC800\uB97C
          \uADF8\uB807\uAC8C \uC595\uC7A1\uACE0 \uC7A5\uB09C\uC2A4\uB7FD\uAC8C \uB300\uD558\uC2DC\uB294
