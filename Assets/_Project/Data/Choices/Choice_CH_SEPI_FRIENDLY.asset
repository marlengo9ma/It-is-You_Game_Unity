          expression: 3
          blurredFromRecallDepth: 2
        autoGrantClueId: 
      - speaker: 3
        text: "\uBD84\uBA85 \uB9D0\uD588\uC9C0\uB9CC \uC800\uB294 \uADF8 \uB9CC\uB144\uD544\uC744
          \uAC00\uC9C0\uACE0 \uC788\uC9C0\uB3C4 \uC54A\uACE0, \uD589\uBC29\uB3C4
