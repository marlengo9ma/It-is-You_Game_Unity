  - note: "A (A>B \uC774\uD6C4, 2\uBC88\uC9F8 \uAD50\uCC28) \u2014 \uC2E0\uB8B0\uB97C
      \uC783\uB294\uB2E4"
    labelOverride: "\uC544, \uC5EC\uB7EC\uBAA8\uB85C \uC774\uD574\uD569\uB2C8\uB2E4.
      \uD639\uC2DC \uC81C\uAC00 \uAC00\uC9C4 \uB2E4\uB978 \uBB3C\uAC74\uACFC \uAD50\uD658\uD558\uC9C0
      \uC54A\uACA0\uC2B5\uB2C8\uAE4C?"
    sequence:
      note: "A (A>B \uC774\uD6C4, 2\uBC88\uC9F8 \uAD50\uCC28) \u2014 \uC2E0\uB8B0\uB97C
        \uC783\uB294\uB2E4"
      lines:
      - speaker: 1
        text: "\uC544, \uC5EC\uB7EC\uBAA8\uB85C \uC774\uD574\uD569\uB2C8\uB2E4. \uD639\uC2DC
          \uC81C\uAC00 \uAC00\uC9C4 \uB2E4\uB978 \uBB3C\uAC74\uACFC \uAD50\uD658\uD558\uC9C0
          \uC54A\uACA0\uC2B5\uB2C8\uAE4C?"
        expression: 0
        stageDirection: 
        animationId: 
        reaction:
          clueId: 
          openDelay: 0
          window: 2.5
          expression: 3
          blurredFromRecallDepth: 2
        autoGrantClueId: 
      - speaker: 3
        text: "\uB124? \uADF8, \uC5B4\u2026? \uBB58 \uC774\uD574\uD558\uC2E0\uB2E4\uB294
          \uB9D0\uC500\uC774\uC2E4\uAE4C\uC694\u2026?"
        expression: 3
        stageDirection: "(\uB2F9\uC2E0\uC758 \uD589\uB3D9\uC774 \uC774\uC0C1\uD558\uB2E4\uB294
          \uB4EF)"
        animationId: startle
