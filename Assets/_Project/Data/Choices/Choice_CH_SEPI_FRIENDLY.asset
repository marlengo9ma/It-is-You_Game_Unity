          expression: 3
          blurredFromRecallDepth: 2
        autoGrantClueId: 
      - speaker: 1
        text: "\uC544\uB1E8, \uADF8\uB7EC\uB824\uB358 \uC758\uB3C4\uB294 \uC5C6\uC5C8\uC2B5\uB2C8\uB2E4\uB9CC\u2026"
