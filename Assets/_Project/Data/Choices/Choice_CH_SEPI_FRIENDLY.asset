          expression: 3
          blurredFromRecallDepth: 2
        autoGrantClueId: 
      - speaker: 3
        text: "\uC544\uBB34\uB9AC \uC81C\uAC00 \uC5B4\uB824\uBCF4\uC5EC\uB3C4 \uC5C4\uC5F0\uD55C
          \uC815\uC2DD \uC218\uC0AC\uAD00\uC774\uC5D0\uC694."
        expression: 4
        stageDirection: 
        animationId: 
        reaction:
          clueId: 
          openDelay: 0
          window: 2.5
          expression: 3
          blurredFromRecallDepth: 2
        autoGrantClueId: 
      - speaker: 3
        text: "\uC0C1\uD669\uC0C1, \uC81C\uAC00 \uC758\uC2EC\uB420\uB9CC \uD558\uB2C8\uAE4C
          \uC2EC\uBB38\uD558\uC2DC\uACE0 \uADF8\uB7F0 \uAC83\uAE4C\uC9C0\uB294 \uC774\uD574\uB97C
          \uD574\uC694."
