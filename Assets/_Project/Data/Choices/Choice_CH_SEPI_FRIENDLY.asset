          clueId: 
          openDelay: 0
          window: 2.5
          expression: 3
          blurredFromRecallDepth: 2
        autoGrantClueId: 
      - speaker: 3
        text: "\uADF8\uB9AC\uACE0 \uBB34\uC5C7\uC744 \uAD50\uD658\uD558\uC2E0\uB2E4\uB294
          \uC774\uC57C\uAE30\uC8E0?"
        expression: 3
        stageDirection: 
        animationId: 
        reaction:
          clueId: 
          openDelay: 0
          window: 2.5
          expression: 3
          blurredFromRecallDepth: 2
        autoGrantClueId: 
      - speaker: 1
        text: "\uC74C? \uB2F9\uC2E0\uC774 \uAC00\uC9C4 \uB9CC\uB144\uD544\uACFC \uC81C\uAC00
          \uAC00\uC9C4 \uB2E4\uB978 \uBB3C\uAC74\uB4E4\uC744 \uC774\uC57C\uAE30\uD558\uB294
          \uAC70\uC8E0?"
        expression: 0
        stageDirection: 
        animationId: 
        reaction:
          clueId: 
          openDelay: 0
          window: 2.5
          expression: 3
          blurredFromRecallDepth: 2
        autoGrantClueId: 
      - speaker: 3
        text: "\u2026\uC9C4\uC2EC\uC774\uC138\uC694, \uC218\uC0AC\uAD00\uB2D8?"
        expression: 4
        stageDirection: "(\uB2F9\uC2E0\uC758 \uC774\uC57C\uAE30\uC5D0 \uD654\uAC00\uB09C
