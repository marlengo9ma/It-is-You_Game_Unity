      lines:
      - speaker: 1
        speakerName: 
        text: "\uADF8\uB9AC\uACE0 \uD14C\uC774\uBE14 \uC704\uB97C \uB6F0\uC5B4\uB2E4\uB2C8\uB294
          \uB3D9\uC548, \uC81C \uB9CC\uB144\uD544\uC740 \uC774\uB807\uAC8C \uB410\uC2B5\uB2C8\uB2E4."
