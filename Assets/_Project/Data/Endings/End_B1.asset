      - speaker: 4
        speakerName: 
        text: "\u2026\uBA01?"
        expression: 0
        stageDirection: "(\uADC0\uB97C \uCAD1\uAE0B)"
        animationId: 
        reaction:
          clueId: 
          openDelay: 0
          window: 2.5
          expression: 3
          blurredFromRecallDepth: 2
        illustration: {fileID: 0}
        bubble: 0
        stand: 0
        autoGrantClueId: 
      - speaker: 3
        speakerName: 
        text: "\uC5D0\uC774, \uADF8\uAC74 \uB108\uBB34\uD574\uC694! \uC598\uB294
          \uC544\uC9C1 \uC544\uBB34\uAC83\uB3C4 \uC548 \uD588\uC796\uC544\uC694\u2026!"
        expression: 3
        stageDirection: "(\uD654\uB4E4\uC9DD \uB180\uB77C\uBA70)"
        animationId: 
        reaction:
          clueId: 
          openDelay: 0
          window: 2.5
          expression: 3
          blurredFromRecallDepth: 2
        illustration: {fileID: 0}
        bubble: 0
        stand: 0
        autoGrantClueId: 
      - speaker: 1
        speakerName: 
        text: "\uC544\uBB34\uAC83\uB3C4\uC694? \uCEE4\uD53C\uC794\uC744 \uB2E4\uC2DC
          \uBCF4\uC2ED\uC2DC\uC624. \uC794\uC740 \uBA40\uCA61\uD55C\uB370 \uB0B4\uC6A9\uBB3C\uB9CC
          \uC0AC\uBC29\uC73C\uB85C \uD280\uC5C8\uC2B5\uB2C8\uB2E4. \uC0AC\uB78C \uC190\uC774\uC5C8\uB2E4\uBA74
          \uC794\uBD80\uD130 \uC7A1\uC558\uACA0\uC8E0."
        expression: 0
        stageDirection: 
        animationId: 
        reaction:
          clueId: 
          openDelay: 0
          window: 2.5
          expression: 3
          blurredFromRecallDepth: 2
        illustration: {fileID: 0}
        bubble: 0
        stand: 0
        autoGrantClueId: 
      - speaker: 1
        speakerName: 
        text: "\uC790\uC720\uBD84\uBC29\uD558\uACE0, \uBE60\uB974\uAC8C \uC6C0\uC9C1\uC774\uB294
          \uBB34\uC5B8\uAC00\uC758 \uC9D3\uC785\uB2C8\uB2E4."
