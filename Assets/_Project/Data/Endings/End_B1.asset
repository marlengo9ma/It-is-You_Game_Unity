          blurredFromRecallDepth: 2
        illustration: {fileID: 0}
        bubble: 0
        stand: 0
        autoGrantClueId: 
      - speaker: 3
        speakerName: 
        text: "\u2026\uADF8 \uB9CC\uB144\uD544, \uBE44\uC2F8 \uBCF4\uC600\uB294\uAC78\uC694."
        expression: 5
        stageDirection: 
