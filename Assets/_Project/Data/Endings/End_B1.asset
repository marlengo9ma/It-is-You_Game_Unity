          window: 2.5
          expression: 3
          blurredFromRecallDepth: 2
        illustration: {fileID: 0}
        bubble: 0
        stand: 0
        autoGrantClueId: 
      - speaker: 1
        speakerName: 
        text: "\uACE0\uC591\uC774\uAC00 \uD55C \uC790\uB9AC\uC5D0\uC11C \uC800\uB807\uAC8C
