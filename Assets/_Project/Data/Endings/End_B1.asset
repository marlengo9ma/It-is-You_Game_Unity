          openDelay: 0
          window: 2.5
          expression: 3
          blurredFromRecallDepth: 2
        illustration: {fileID: 0}
        bubble: 0
        stand: 0
        autoGrantClueId: 
      - speaker: 3
        speakerName: 
        text: "\u2026\uADF8\uB7F0\uB370 \uC218\uC0AC\uAD00\uB2D8, \uC598\uAC00 \uB9CC\uB144\uD544\uC744
          \uAE54\uACE0 \uC549\uC544 \uC788\uB294 \uAC83\uAE4C\uC9C0 \uCC98\uC74C\uBD80\uD130
          \uC544\uC168\uB358 \uAC70\uC608\uC694?"
