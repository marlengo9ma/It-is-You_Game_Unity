        bubble: 0
        stand: 0
        autoGrantClueId: 
      - speaker: 0
        speakerName: 
        text: "\uB2F9\uC2E0\uC740 \uC2B9\uBB34\uC6D0\uC744 \uBD80\uB974\uB294 \uC904\uC744
