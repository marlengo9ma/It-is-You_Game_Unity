          clueId: 
          openDelay: 0
          window: 2.5
          expression: 3
          blurredFromRecallDepth: 2
        illustration: {fileID: 0}
        bubble: 0
        stand: 0
        autoGrantClueId: 
      - speaker: 1
        speakerName: 
        text: "\uD558\uC544\u2026\uADF8\uB0E5 \uB9D0\uD558\uBA74 \uB410\uB358 \uAC70
