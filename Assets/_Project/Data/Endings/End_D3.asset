  steps:
  - note: "[\uC2DC\uC548] D-3 \u2014 \uC9C0\uBAA9 \uD654\uBA74 \uADF8\uB300\uB85C"
    screen: 0
    cut: {fileID: 0}
    effect: 0
    talk:
      note: "[\uC2DC\uC548] D-3 \uC2E0\uBB38"
      lines:
      - speaker: 1
        speakerName: 
        text: "\uC774 \uC2E0\uBB38\uC744 \uBCF4\uC2ED\uC2DC\uC624."
        expression: 0
        stageDirection: 
        animationId: 
        reaction:
          clueId: 
          openDelay: 0
          window: 2.5
          expression: 3
          blurredFromRecallDepth: 2
        illustration: {fileID: 0}
        bubble: 0
        stand: 0
        autoGrantClueId: 
      - speaker: 3
        speakerName: 
        text: "\u2026\uC2E0\uBB38\uC774\uC694?"
        expression: 6
        stageDirection: 
        animationId: 
        reaction:
          clueId: 
          openDelay: 0
          window: 2.5
          expression: 3
          blurredFromRecallDepth: 2
        illustration: {fileID: 0}
        bubble: 0
        stand: 0
        autoGrantClueId: 
      - speaker: 1
        speakerName: 
        text: "\uC5EC\uAE30 \uCEE4\uD53C \uC5BC\uB8E9\uC774 \uC788\uC2B5\uB2C8\uB2E4.
          \uBC94\uC778\uC774 \uB0A8\uAE34 \uD754\uC801\uC785\uB2C8\uB2E4."
        expression: 0
        stageDirection: 
        animationId: 
        reaction:
          clueId: 
          openDelay: 0
          window: 2.5
          expression: 3
          blurredFromRecallDepth: 2
        illustration: {fileID: 0}
        bubble: 0
        stand: 0
        autoGrantClueId: 
      - speaker: 3
        speakerName: 
        text: "\uADF8 \uC5BC\uB8E9\uC740\u2026 \uC218\uC0AC\uAD00\uB2D8\uC774 \uAE30\uCC28\uC5ED\uC5D0\uC11C
          \uCEE4\uD53C\uB97C \uB9AC\uD544\uD558\uC2DC\uBA74\uC11C \uD758\uB9AC\uC2E0
          \uAC70\uC796\uC544\uC694."
        expression: 8
        stageDirection: "(\uACE0\uAC1C\uB97C \uAC38\uC6C3\uD558\uBA70)"
        animationId: 
        reaction:
          clueId: 
          openDelay: 0
          window: 2.5
          expression: 3
          blurredFromRecallDepth: 2
        illustration: {fileID: 0}
        bubble: 0
        stand: 0
        autoGrantClueId: 
      - speaker: 3
        speakerName: 
        text: "\uADF8\uAC8C \uB9CC\uB144\uD544\uC774\uB791 \uBB34\uC2A8 \uC0C1\uAD00\uC778\uB370\uC694?"
        expression: 8
        stageDirection: 
        animationId: 
        reaction:
          clueId: 
          openDelay: 0
          window: 2.5
          expression: 3
          blurredFromRecallDepth: 2
        illustration: {fileID: 0}
        bubble: 0
        stand: 0
        autoGrantClueId: 
      - speaker: 4
        speakerName: 
        text: "\u2026\uBA01."
        expression: 0
        stageDirection: "(\uB208\uC744 \uAC10\uACE0 \uB298\uC5B4\uC9C0\uAC8C \uD558\uD488\uD55C\uB2E4)"
        animationId: 
        reaction:
          clueId: 
          openDelay: 0
          window: 2.5
          expression: 3
          blurredFromRecallDepth: 2
        illustration: {fileID: 0}
        bubble: 0
        stand: 0
        autoGrantClueId: 
      - speaker: 2
        speakerName: 
        text: "\u2026\uC544\uB2C8, \uC774\uAC8C \uC544\uB2CC\uB370."
        expression: 0
        stageDirection: 
        animationId: 
        reaction:
          clueId: 
          openDelay: 0
          window: 2.5
          expression: 3
          blurredFromRecallDepth: 2
        illustration: {fileID: 0}
        bubble: 0
        stand: 0
        autoGrantClueId: 
      - speaker: 1
        speakerName: 
        text: "\uC0C1\uAD00\uC774 \uC788\uC2B5\uB2C8\uB2E4. \uBC94\uC778\uC740 \uCC98\uC74C\uBD80\uD130\u2014"
        expression: 0
        stageDirection: 
        animationId: 
        reaction:
          clueId: 
          openDelay: 0
          window: 2.5
          expression: 3
          blurredFromRecallDepth: 2
        illustration: {fileID: 0}
        bubble: 0
        stand: 0
        autoGrantClueId: 
      - speaker: 3
        speakerName: 
        text: "\u2026\uC218\uC0AC\uAD00\uB2D8."
        expression: 4
        stageDirection: "(\uD45C\uC815\uC774 \uCC9C\uCC9C\uD788 \uC2DD\uB294\uB2E4)"
        animationId: 
        reaction:
          clueId: 
          openDelay: 0
          window: 2.5
          expression: 3
          blurredFromRecallDepth: 2
        illustration: {fileID: 21300000, guid: da0a8fa40e3352d4ba0803d08a61bf94, type: 3}
        bubble: 0
        stand: 0
        autoGrantClueId: 
      - speaker: 3
        speakerName: 
        text: "\uBCF8\uBD80 \uAE30\uB85D\uC5D0 \uC4F0\uC5EC \uC788\uB358 \uAC70,
          \uBC18\uC740 \uB9DE\uB124\uC694. \uC218\uC0AC\uD560 \uB54C \uC0AC\uB78C\uC774
          \uBC14\uB010\uB2E4\uB294 \uAC70."
        expression: 5
        stageDirection: 
        animationId: 
        reaction:
          clueId: 
          openDelay: 0
          window: 2.5
          expression: 3
          blurredFromRecallDepth: 2
        illustration: {fileID: 0}
        bubble: 0
        stand: 0
        autoGrantClueId: 
      - speaker: 3
        speakerName: 
        text: "\u2026\uC640, \uC5ED\uC2DC \uC218\uC0AC\uAD00\uB2D8\uC774\uC2DC\uB124\uC694."
        expression: 5
        stageDirection: "(\uC9E7\uAC8C \uD55C\uC228\uC744 \uC26C\uBA70)"
        animationId: 
        reaction:
          clueId: 
          openDelay: 0
          window: 2.5
          expression: 3
          blurredFromRecallDepth: 2
        illustration: {fileID: 0}
        bubble: 0
        stand: 0
        autoGrantClueId: 
      - speaker: 0
        speakerName: 
        text: "\uC138\uD53C\uB294 \uB354 \uC774\uC0C1 \uB2F9\uC2E0\uC744 \uBCF4\uC9C0
          \uC54A\uACE0, \uD14C\uC774\uBE14 \uC704\uC758 \uB9AC\uBCF8\uC744 \uC8FC\uC6CC
          \uACE0\uC591\uC774 \uC55E\uC5D0 \uB193\uB294\uB2E4."
        expression: 0
        stageDirection: 
        animationId: 
        reaction:
          clueId: 
          openDelay: 0
          window: 2.5
          expression: 3
          blurredFromRecallDepth: 2
        illustration: {fileID: 0}
        bubble: 0
        stand: 0
        autoGrantClueId: 
      - speaker: 3
        speakerName: 
        text: "\uAC00\uC790. \uC5EC\uAE30 \uC788\uC5B4\uBD10\uC57C \uD63C\uB098\uAE30\uB9CC
          \uD558\uACA0\uB2E4."
        expression: 5
        stageDirection: 
        animationId: 
        reaction:
          clueId: 
          openDelay: 0
          window: 2.5
          expression: 3
          blurredFromRecallDepth: 2
        illustration: {fileID: 0}
        bubble: 0
        stand: 0
        autoGrantClueId: 
      - speaker: 0
        speakerName: 
        text: "\uACE0\uC591\uC774\uAC00 \uC790\uB9AC\uC5D0\uC11C \uC77C\uC5B4\uB09C\uB2E4.
          \uADF8 \uBC11\uC5D0\uC11C \uBD80\uC11C\uC9C4 \uB9CC\uB144\uD544 \uC870\uAC01\uC774
          \uB4DC\uB7EC\uB0AC\uC9C0\uB9CC, \uC138\uD53C\uB294 \uB3CC\uC544\uBCF4\uC9C0
          \uC54A\uB294\uB2E4."
        expression: 0
        stageDirection: 
        animationId: 
        reaction:
          clueId: 
          openDelay: 0
          window: 2.5
          expression: 3
          blurredFromRecallDepth: 2
        illustration: {fileID: 0}
        bubble: 0
        stand: 0
        autoGrantClueId: 
      - speaker: 2
        speakerName: 
        text: "\u2026\uADF8\uB7F0 \uB370\uC5D0 \uC788\uC5C8\uAD70."
        expression: 0
        stageDirection: 
        animationId: 
        reaction:
          clueId: 
          openDelay: 0
          window: 2.5
          expression: 3
          blurredFromRecallDepth: 2
        illustration: {fileID: 0}
        bubble: 0
        stand: 0
        autoGrantClueId: 
