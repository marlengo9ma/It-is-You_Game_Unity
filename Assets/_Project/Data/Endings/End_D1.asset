          window: 2.5
          expression: 3
          blurredFromRecallDepth: 2
        illustration: {fileID: 0}
        bubble: 0
        stand: 0
        autoGrantClueId: 
      - speaker: 0
        speakerName: 
        text: "\uC138\uD53C\uAC00 \uB9C8\uC9C0\uB9C9 \uC904\uC744 \uCE58\uACE0 \uC885\uC774\uB97C
          \uBF51\uB294\uB2E4. \uADF8\uB9AC\uACE0 \uD0C0\uC790\uAE30 \uB36E\uAC1C\uB97C
