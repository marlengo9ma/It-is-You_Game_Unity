        bubble: 0
        stand: 0
        autoGrantClueId: 
      - speaker: 3
        speakerName: 
        text: "\uB2E4\uC74C \uC5ED\uC5D0\uC11C \uBCF8\uBD80\uB85C \uBCF4\uB0BC \uC804\uBCF4\uC608\uC694.
