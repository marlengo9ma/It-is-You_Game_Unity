          clueId: 
          openDelay: 0
          window: 2.5
          expression: 3
          blurredFromRecallDepth: 2
        illustration: {fileID: 0}
        bubble: 0
        stand: 0
        autoGrantClueId: 
      - speaker: 3
        speakerName: 
        text: "\uC544\uAE4C \uB9D0\uC500\uB4DC\uB838\uC8E0. \uADF8\uB807\uAC8C \uC758\uC2EC\uC2A4\uB7EC\uC6B0\uC2DC\uBA74
          \uBC14\uAFB8\uC2DC\uB294 \uAC8C \uB9DE\uB2E4\uACE0. \uC218\uC0AC\uAD00\uB2D8\uC774
          \uC548 \uD558\uC2DC\uB2C8\uAE4C, \uC81C\uAC00 \uD558\uB294 \uAC70\uC608\uC694."
