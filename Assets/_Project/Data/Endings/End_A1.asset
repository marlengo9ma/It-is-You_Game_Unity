  id: End_A1
  title: "\uBD80\uC8FC\uC758 \uD310\uACB0"
  code: ENDING  A-1
  kind: 0
  suspectId: SEPI
  steps:
  - note: "[\uC2DC\uC548] A-1 \u2014 \uC9C0\uBAA9 \uD654\uBA74 \uADF8\uB300\uB85C"
    screen: 0
    cut: {fileID: 0}
    effect: 0
    talk:
      note: "[\uC2DC\uC548] A-1 \uC815\uB9AC"
      lines:
      - speaker: 1
        speakerName: 
        text: "\uC815\uB9AC\uD558\uC8E0. \uCEE4\uD53C\uB97C \uC3DF\uC740 \uAC74,
          \uBCF4\uC870 \uC218\uC0AC\uAD00\uC785\uB2C8\uB2E4."
        expression: 0
        stageDirection: 
        animationId: 
        reaction:
          clueId: 
          openDelay: 0
          window: 2.5
          expression: 3
          blurredFromRecallDepth: 2
        illustration: {fileID: 0}
        bubble: 0
        stand: 0
        autoGrantClueId: 
      - speaker: 3
        speakerName: 
        text: "\uB124? \uC81C, \uC81C\uAC00\uC694?"
        expression: 6
        stageDirection: "(\uB208\uC774 \uD718\uB465\uADF8\uB808\uC838\uC11C)"
        animationId: 
        reaction:
          clueId: 
          openDelay: 0
          window: 2.5
          expression: 3
          blurredFromRecallDepth: 2
        illustration: {fileID: 0}
        bubble: 0
        stand: 0
        autoGrantClueId: 
      - speaker: 1
        speakerName: 
        text: "\uD14C\uC774\uBE14 \uC704\uC758 \uC5BC\uB8E9\uC740 \uD55C\uCABD\uC73C\uB85C\uB9CC
          \uD280\uC5B4 \uC788\uC2B5\uB2C8\uB2E4. \uB204\uAD70\uAC00 \uC794 \uBC14\uB85C
          \uC606\uC5D0\uC11C \uD06C\uAC8C \uC6C0\uC9C1\uC600\uB2E4\uB294 \uB73B\uC774\uC8E0."
        expression: 0
        stageDirection: 
        animationId: 
        reaction:
          clueId: 
          openDelay: 0
          window: 2.5
          expression: 3
          blurredFromRecallDepth: 2
        illustration: {fileID: 21300000, guid: da0a8fa40e3352d4ba0803d08a61bf94, type: 3}
        bubble: 0
        stand: 0
        autoGrantClueId: 
      - speaker: 3
        speakerName: 
        text: "\uC544\uB2C8\uC5D0\uC694! \uC800\uB294 \uCEE4\uD53C\uC794\uC5D0 \uC190\uB3C4
          \uC548 \uB314\uB294\uAC78\uC694!"
        expression: 3
        stageDirection: "(\uB450 \uC190\uC744 \uB0B4\uC800\uC73C\uBA70)"
        animationId: 
        reaction:
          clueId: 
          openDelay: 0
          window: 2.5
          expression: 3
          blurredFromRecallDepth: 2
        illustration: {fileID: 0}
        bubble: 0
        stand: 0
        autoGrantClueId: 
      - speaker: 1
        speakerName: 
        text: "\uC190\uC740 \uC548 \uB300\uC168\uACA0\uC8E0. \uB300\uC2E0 \uC774\uAC74
          \uC5B4\uB5BB\uC2B5\uB2C8\uAE4C?"
        expression: 0
        stageDirection: 
        animationId: 
        reaction:
          clueId: 
          openDelay: 0
          window: 2.5
          expression: 3
          blurredFromRecallDepth: 2
        illustration: {fileID: 0}
        bubble: 0
        stand: 0
        autoGrantClueId: 
      - speaker: 0
        speakerName: 
        text: "\uB2F9\uC2E0\uC740 \uCEE4\uD53C \uC790\uAD6D\uC774 \uBC34 \uB9AC\uBCF8\uC744
          \uD14C\uC774\uBE14 \uC704\uC5D0 \uB0B4\uB824\uB193\uB294\uB2E4."
        expression: 0
        stageDirection: 
        animationId: 
        reaction:
          clueId: 
          openDelay: 0
          window: 2.5
          expression: 3
          blurredFromRecallDepth: 2
        illustration: {fileID: 0}
        bubble: 0
        stand: 0
        autoGrantClueId: 
      - speaker: 1
        speakerName: 
        text: "\uCEE4\uD53C \uC5BC\uB8E9\uC5D0, \uACE0\uC591\uC774 \uD138. \uC774
          \uB9AC\uBCF8\uC740 \uCEE4\uD53C\uAC00 \uC3DF\uC544\uC9C8 \uB54C \uBC14\uB85C
          \uADF8 \uC790\uB9AC\uC5D0 \uC788\uC5C8\uC2B5\uB2C8\uB2E4."
        expression: 0
        stageDirection: 
        animationId: 
        reaction:
          clueId: 
          openDelay: 0
          window: 2.5
          expression: 3
          blurredFromRecallDepth: 2
        illustration: {fileID: 0}
        bubble: 0
        stand: 0
        autoGrantClueId: 
      - speaker: 3
        speakerName: 
        text: "\uADF8, \uADF8\uAC74\u2026"
