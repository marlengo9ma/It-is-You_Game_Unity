        stageDirection: 
        animationId: 
        reaction:
          clueId: 
          openDelay: 0
          window: 2.5
          expression: 3
          blurredFromRecallDepth: 2
        illustration: {fileID: 0}
        bubble: 0
        stand: 0
        autoGrantClueId: 
      - speaker: 1
        speakerName: 
        text: "\uADF8\uB9AC\uACE0 \uC544\uAE4C \uADF8\uB7EC\uC168\uC8E0. \u2018\uC544\uAE4C
          \uBD24\uB358 \uAC83 \uAC19\uAE34 \uD55C\uB370\uC694.\u2019 \uBCF4\uC168\uB2E4\uB294
          \uAC74, \uADF8 \uC790\uB9AC\uC5D0 \uACC4\uC168\uB2E4\uB294 \uB73B\uC785\uB2C8\uB2E4."
