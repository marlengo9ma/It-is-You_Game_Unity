      stand: 0
      trustDelta: 0
      endsInterrogation: 0
  - note: "[\uC2DC\uC548] D-2 \u2014 \uAC70\uC6B8\uC774 \uD750\uB824\uC9C4\uB2E4"
    screen: 0
