  - note: "[\uC2DC\uC548] D-2 \u2014 \uCEF7 scene_#1E (\uD654\uC7A5\uC2E4 \uAC70\uC6B8)"
    screen: 1
    cut: {fileID: 21300000, guid: b1bb6fcf57795724ba272a9fceeaab07, type: 3}
    effect: 0
    talk:
      note: "[\uC2DC\uC548] D-2 \uAC70\uC6B8"
      lines:
      - speaker: 0
        speakerName: 
        text: "\uB2F9\uC2E0\uC740 \uB2E4\uC2DC \uC138\uBA74\uB300 \uAC70\uC6B8 \uC55E\uC5D0
          \uC120\uB2E4. \uBA87 \uC2DC\uAC04 \uC804\uACFC \uAC19\uC740 \uC790\uB9AC\uB2E4."
        expression: 0
        stageDirection: 
        animationId: 
        reaction:
          clueId: 
          openDelay: 0
          window: 2.5
          expression: 3
          blurredFromRecallDepth: 2
        illustration: {fileID: 0}
        bubble: 0
        stand: 0
        autoGrantClueId: 
      - speaker: 2
        speakerName: 
        text: "\uBB34\uC5B8\uAC00 \uB192\uC740 \uC0AC\uB78C\uC758 \uB4B7\uBC30\uB77C\uB3C4
          \uC788\uB294 \uAC74\uAC00. \uADF8\uB807\uAC8C \uC0DD\uAC01\uD588\uC5C8\uC9C0."
        expression: 0
        stageDirection: 
        animationId: 
        reaction:
          clueId: 
          openDelay: 0
          window: 2.5
          expression: 3
          blurredFromRecallDepth: 2
        illustration: {fileID: 0}
        bubble: 0
        stand: 0
        autoGrantClueId: 
      - speaker: 2
        speakerName: 
        text: "\uD558\uC9C0\uB9CC \uC758\uC2EC\uD574\uC57C \uD560 \uAC74 \uADF8 \uC18C\uB140\uC758
          \uC774\uB825\uC774 \uC544\uB2C8\uC5C8\uB2E4."
        expression: 0
        stageDirection: 
        animationId: 
        reaction:
          clueId: 
          openDelay: 0
          window: 2.5
          expression: 3
          blurredFromRecallDepth: 2
        illustration: {fileID: 0}
        bubble: 0
        stand: 0
        autoGrantClueId: 
      - speaker: 2
        speakerName: 
        text: "\uD45C\uC815\uC744 \uC77D\uB294\uB2E4\uB294 \uB0B4\uAC00, \uC18C\uB140
          \uD558\uB098\uC640 \uACE0\uC591\uC774 \uD55C \uB9C8\uB9AC\uC758 \uC5BC\uAD74\uB3C4
          \uC77D\uC9C0 \uBABB\uD588\uB2E4."
        expression: 0
        stageDirection: 
        animationId: 
        reaction:
          clueId: 
          openDelay: 0
          window: 2.5
          expression: 3
          blurredFromRecallDepth: 2
        illustration: {fileID: 0}
        bubble: 0
        stand: 0
