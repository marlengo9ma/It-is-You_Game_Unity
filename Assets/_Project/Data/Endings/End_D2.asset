    talk:
      note: "[\uC2DC\uC548] D-2 \uCD94\uB860 \uD654\uBA74"
      lines:
      - speaker: 0
        speakerName: 
        text: "\uB9C8\uC9C0\uB9C9 \uC789\uD06C \uBC29\uC6B8\uC774 \uB9C8\uB978\uB2E4.
          \uC218\uCCA9\uC5D0\uB294 \uC774\uC5C8\uB2E4 \uC9C0\uC6B4 \uC120\uB4E4\uB9CC
          \uACA8\uC6B0 \uB0A8\uC544 \uC788\uB2E4."
        expression: 0
        stageDirection: 
        animationId: 
        reaction:
          clueId: 
          openDelay: 0
          window: 2.5
          expression: 3
          blurredFromRecallDepth: 2
        illustration: {fileID: 0}
        bubble: 0
        stand: 0
        autoGrantClueId: 
      - speaker: 2
        speakerName: 
        text: "\u2026\uD5C8\uD22C\uB85C \uB0AD\uBE44\uD558\uC9C0 \uC54A\uACA0\uB2E4\uACE0
          \uD588\uAC74\uB9CC."
        expression: 0
        stageDirection: 
        animationId: 
        reaction:
          clueId: 
          openDelay: 0
          window: 2.5
          expression: 3
          blurredFromRecallDepth: 2
        illustration: {fileID: 0}
        bubble: 0
        stand: 0
        autoGrantClueId: 
      - speaker: 3
        speakerName: 
        text: "\uC218\uC0AC\uAD00\uB2D8\u2026? \uC815\uB9AC, \uB2E4 \uB418\uC168\uC5B4\uC694?"
        expression: 2
        stageDirection: "(\uC870\uC2EC\uC2A4\uB7FD\uAC8C)"
        animationId: 
        reaction:
          clueId: 
          openDelay: 0
          window: 2.5
          expression: 3
          blurredFromRecallDepth: 2
        illustration: {fileID: 0}
        bubble: 0
        stand: 0
        autoGrantClueId: 
      - speaker: 1
        speakerName: 
        text: "\u2026\uC7A0\uC2DC \uC790\uB9AC \uC880 \uBE44\uC6B0\uACA0\uC2B5\uB2C8\uB2E4."
        expression: 0
        stageDirection: 
        animationId: 
        reaction:
          clueId: 
          openDelay: 0
          window: 2.5
          expression: 3
          blurredFromRecallDepth: 2
