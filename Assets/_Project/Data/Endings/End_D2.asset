      lines:
      - speaker: 0
        speakerName: 
        text: "\uAC70\uC6B8 \uC18D \uC5BC\uAD74\uC774 \uCC9C\uCC9C\uD788 \uD750\uB824\uC9C4\uB2E4.
          \uAE30\uC5B5 \uC9D0\uC791\uCC98\uB7FC, \uD55C \uBC88\uC529 \uB354."
        expression: 0
        stageDirection: 
        animationId: 
        reaction:
          clueId: 
          openDelay: 0
          window: 2.5
          expression: 3
          blurredFromRecallDepth: 2
        illustration: {fileID: 0}
        bubble: 0
        stand: 0
        autoGrantClueId: 
      - speaker: 2
        speakerName: 
        text: "\u2026\uC9C0\uAE08 \uC774 \uC5BC\uAD74\uC740, \uBB34\uC2A8 \uD45C\uC815\uC774\uC9C0."
        expression: 0
        stageDirection: 
        animationId: 
        reaction:
          clueId: 
          openDelay: 0
          window: 2.5
          expression: 3
          blurredFromRecallDepth: 2
        illustration: {fileID: 0}
        bubble: 0
        stand: 0
        autoGrantClueId: 
      - speaker: 0
        speakerName: 
        text: "\uADF8 \uC9C8\uBB38\uC5D0 \uB2F5\uD560 \uC218 \uC5C6\uB2E4\uB294 \uAC83\uC774,
          \uB2F9\uC2E0\uC5D0\uAC8C\uB294 \uBB34\uC5C7\uBCF4\uB2E4 \uB354 \uB0AF\uC120
