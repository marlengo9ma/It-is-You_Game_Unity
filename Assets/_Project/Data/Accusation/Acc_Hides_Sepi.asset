  options:
  - label: "\uACE0\uC591\uC774\uB97C \uC228\uAE30\uB824\uB358 \uC18C\uB3D9 \uC18D\uC5D0\uC11C
      \uB9CC\uB144\uD544\uC744 \uCE58\uC6E0\uB2E4."
    speech:
      note: "[\uC784\uC2DC] \uCD94\uB860 H2\xD7\uC138\uD53C A"
      lines:
      - speaker: 1
        speakerName: 
        text: "\uC138\uD53C \uC528, \uB2F9\uC2E0\uC740 \uACE0\uC591\uC774\uB97C \uC228\uAE30\uACE0
          \uC788\uC5C8\uC2B5\uB2C8\uB2E4. \uCEE4\uD53C\uB97C \uC5CE\uC9C0\uB978 \uAC83\uB3C4,
          \uB9AC\uBCF8\uC774 \uB354\uB7EC\uC6CC\uC9C4 \uAC83\uB3C4 \uADF8 \uC18C\uB3D9\uC774\uC5C8\uACE0."
        expression: 0
        stageDirection: 
        animationId: 
        reaction:
          clueId: 
          openDelay: 0
          window: 2.5
          expression: 3
          blurredFromRecallDepth: 2
        autoGrantClueId: 
      - speaker: 1
        speakerName: 
        text: "\uADF8 \uC640\uC911\uC5D0 \uB9CC\uB144\uD544\uC774 \uACE0\uC591\uC774
          \uC544\uB798\uB85C \uB4E4\uC5B4\uAC14\uC8E0. \uB2F9\uC2E0\uC740 \uC54C\uBA74\uC11C
          \uBAA8\uB978 \uCC99\uD588\uACE0\uC694."
        expression: 0
        stageDirection: 
        animationId: 
        reaction:
          clueId: 
          openDelay: 0
          window: 2.5
          expression: 3
          blurredFromRecallDepth: 2
        autoGrantClueId: 
      - speaker: 3
        speakerName: 
        text: "\u2026"
        expression: 7
        stageDirection: 
        animationId: 
        reaction:
          clueId: 
          openDelay: 0
          window: 2.5
          expression: 3
          blurredFromRecallDepth: 2
        autoGrantClueId: 
      animationId: 
      trustDelta: 0
      endsInterrogation: 0
    plea:
      note: "[\uC784\uC2DC] \uD638\uC18C H2\xD7\uC138\uD53C A"
      lines:
      - speaker: 3
        speakerName: 
        text: "\uACE0\uC591\uC774\uB294\u2026 \uB9DE\uC544\uC694. \uD558\uC9C0\uB9CC
          \uB9CC\uB144\uD544\uC740 \uC815\uB9D0 \uBAB0\uB77C\uC694. \uB9AC\uBCF8\uC774
          \uB354\uB7EC\uC6CC\uC9C4 \uAC83\uB3C4 \uADF8\uB0E5 \uACE0\uC591\uC774\uAC00
