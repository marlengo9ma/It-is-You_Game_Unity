    - CLUE_GLIMPSE
    - REA_CAT_FLINCH
    refuteWrong:
      note: "[\uC784\uC2DC] \uBC18\uBC15 \uC2E4\uD328 H3\xD7\uC138\uD53C A"
      lines:
      - speaker: 3
        text: "\u2026\uADF8\uAC74 \uADF8\uB54C \uC77C\uC774\uB791 \uC0C1\uAD00\uC5C6\uC5B4\uC694."
        expression: 2
