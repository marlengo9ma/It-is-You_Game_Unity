          expression: 3
          blurredFromRecallDepth: 2
        autoGrantClueId: 
      - speaker: 2
        text: "..\uADF8\uB807\uB2E4. \uB2E4\uB978 \uAC78 \uB300\uC57C \uD55C\uB2E4."
