      lines:
      - speaker: 1
        text: "\uAD74\uB7EC\uAC04 \uACF3\uC774 \uD558\uD544 \uACE0\uC591\uC774 \uC544\uB798\uAD70\uC694.
          \uACE0\uC591\uC774 \uC774\uC57C\uAE30\uB9CC \uB098\uC624\uBA74 \uC5BC\uAD74\uC774
