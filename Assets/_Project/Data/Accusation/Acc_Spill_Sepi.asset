  options:
  - label: "\uCEE4\uD53C\uB97C \uC5CE\uC9C0\uB978 \uC21C\uAC04, \uC138\uD53C\uAC00
      \uB9CC\uB144\uD544\uC744 \uCE58\uC6E0\uB2E4."
    speech:
      note: "[\uC784\uC2DC] \uCD94\uB860 H3\xD7\uC138\uD53C A"
      lines:
      - speaker: 1
        text: "\uCEE4\uD53C\uAC00 \uC3DF\uC544\uC9C4 \uADF8\uB54C, \uB9CC\uB144\uD544\uC774
          \uC790\uB9AC\uB97C \uC62E\uACBC\uC2B5\uB2C8\uB2E4. \uADF8 \uC790\uB9AC\uC5D0
          \uC788\uB358 \uAC74 \uB2F9\uC2E0\uBFD0\uC774\uC5C8\uC8E0."
        expression: 0
        stageDirection: 
        reaction:
          clueId: 
          openDelay: 0
          window: 2.5
          expression: 3
          blurredFromRecallDepth: 2
        autoGrantClueId: 
      - speaker: 3
        text: "\uC800, \uC800\uB294 \uADF8\uB54C \uB2E6\uB290\uB77C\u2026"
        expression: 3
        stageDirection: 
        reaction:
          clueId: 
          openDelay: 0
          window: 2.5
          expression: 3
          blurredFromRecallDepth: 2
        autoGrantClueId: 
      trustDelta: 0
      endsInterrogation: 0
    plea:
      note: "[\uC784\uC2DC] \uD638\uC18C H3\xD7\uC138\uD53C A"
      lines:
      - speaker: 3
        text: "\uCEE4\uD53C\uB294 \uC815\uB9D0 \uC2E4\uC218\uC600\uC5B4\uC694. \uB9CC\uB144\uD544\uC740\u2026
          \uB2E6\uB2E4\uAC00 \uC5B4\uB514 \uAD74\uB7EC\uAC14\uB098 \uBD10\uC694.
          \uC81C\uAC00 \uCE58\uC6B4 \uAC8C \uC544\uB2C8\uC5D0\uC694."
        expression: 2
        stageDirection: 
        reaction:
          clueId: 
          openDelay: 0
          window: 2.5
          expression: 3
          blurredFromRecallDepth: 2
        autoGrantClueId: 
      trustDelta: 0
      endsInterrogation: 0
