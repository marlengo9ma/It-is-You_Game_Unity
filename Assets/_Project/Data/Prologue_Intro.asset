  - cutName: "\uC11C\uB958\uB97C \uB4E4\uC5EC\uB2E4\uBCF4\uB294 \uB2F9\uC2E0 \u2014
      \"\uC74C\u2026\""
    image: {fileID: 0}
    hasInteraction: 1
    interaction:
      label: "\uC804\uB2EC\uBC1B\uC740 \uC11C\uB958"
      area:
        serializedVersion: 2
        x: 0.36
        y: 0.2
        width: 0.28
        height: 0.26
      popupImage: {fileID: 0}
      popupPlaceholder: "\uFF1C\uBCF4\uC870 \uC218\uC0AC\uAD00 \uC778\uC801\uC0AC\uD56D
        \u2014 \uC11C\uB958 \uCEF7 \uC774\uBBF8\uC9C0 \uC790\uB9AC\uFF1E\n\n\xB7
        \uC573\uB41C \uC18C\uB140\uC758 \uC99D\uBA85\uC0AC\uC9C4\n\xB7 \uD2B9\uAE30\uC0AC\uD56D\uB780\uC5D0
        \uC218\uAE30\uB85C \uC801\uD78C <hl>\u2018\uC21C\uAC04 \uAE30\uC5B5 \uB2A5\uB825\u2019</hl>
        \uACFC \u2018\uC18D\uAE30\uC0AC\u2019 \uC790\uACA9\uC99D\n\xB7 \u2018\uC21C\uAC04
        \uAE30\uC5B5 \uB2A5\uB825\u2019 \uC704\uC5D0 \uC120\uBA85\uD558\uAC8C \uCC0D\uD78C
        <hl>\uACF5\uC778 \uB3C4\uC7A5</hl>\n\n\uC774 \uD31D\uC5C5\uC740 \uC11C\uB958
        \uC77C\uB7EC\uC2A4\uD2B8\uB85C \uAD50\uCCB4\uB420 \uC790\uB9AC\uC785\uB2C8\uB2E4."
  - cutName: "\uB9CC\uB144\uD544\uC744 \uAEBC\uB0B4 \uC11C\uB958 \uAD6C\uC11D\uC5D0
