  - backdropName: "\uAE30\uCC28\uC5ED \u2014 \uAC1C\uCC30\uAD6C"
    backdrop: {fileID: 0}
    lines:
      note: "\uD0C0\uC790\uAE30"
      lines:
      - speaker: 3
        text: "\uC557, \uC870\uC0AC\uAD00\uB2D8. \uC800 \uD0C0\uC790\uAE30\uB294\uC694?"
        expression: 0
        stageDirection: "(\uD14C\uC774\uBE14 \uCABD\uC744 \uAC00\uB9AC\uD0A4\uBA70)"
        reaction:
          clueId: 
          openDelay: 0
          window: 2.5
          expression: 3
          blurredFromRecallDepth: 2
        autoGrantClueId: 
      - speaker: 1
        text: "\u2026\uC800 \uD0C0\uC790\uAE30\uB3C4 \uCC59\uACA8\uC694. \uB2F9\uC2E0
          \uAC81\uB2C8\uB2E4."
        expression: 0
        stageDirection: 
        reaction:
          clueId: 
          openDelay: 0
          window: 2.5
          expression: 3
          blurredFromRecallDepth: 2
        autoGrantClueId: 
      - speaker: 3
        text: "\u2026\uB124? \uC800, \uC815\uB9D0\uC694?!"
        expression: 6
        stageDirection: 
        reaction:
          clueId: 
          openDelay: 0
          window: 2.5
          expression: 3
          blurredFromRecallDepth: 2
        autoGrantClueId: 
      - speaker: 0
        text: "\uC870\uC218\uB294 \uD0C0\uC790\uAE30\uB97C \uB450 \uD314\uB85C \uB04C\uC5B4\uC548\uACE0
          \uC885\uC885\uAC78\uC74C\uC73C\uB85C \uB4A4\uB97C \uB530\uB77C\uC654\uB2E4."
        expression: 0
        stageDirection: 
        reaction:
          clueId: 
          openDelay: 0
          window: 2.5
          expression: 3
          blurredFromRecallDepth: 2
        autoGrantClueId: 
      - speaker: 2
        text: "\uB9AC\uBCF8\uC740\u2026 \uBB50, \uB450\uACE0 \uAC00\uB3C4 \uC0C1\uAD00\uC5C6\uACA0\uC9C0."
        expression: 0
        stageDirection: 
        reaction:
          clueId: 
          openDelay: 0
          window: 2.5
          expression: 3
          blurredFromRecallDepth: 2
        autoGrantClueId: 
      trustDelta: 0
      endsInterrogation: 0
