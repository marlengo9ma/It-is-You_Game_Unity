  - backdropName: "\uAE30\uCC28 \u2014 \uAC1D\uC2E4"
    backdrop: {fileID: 0}
    lines:
      note: "\uC790\uB9AC\uC5D0 \uC549\uB2E4"
      lines:
      - speaker: 0
        text: "\uAC1D\uC2E4\uC740 \uC870\uC6A9\uD588\uB2E4. \uCC3D\uBC16\uC73C\uB85C
          \uC5ED\uC0AC\uAC00 \uCC9C\uCC9C\uD788 \uBC00\uB824\uB098\uAE30 \uC2DC\uC791\uD588\uB2E4."
        expression: 0
        stageDirection: 
        reaction:
          clueId: 
          openDelay: 0
          window: 2.5
          expression: 3
          blurredFromRecallDepth: 2
        autoGrantClueId: 
      - speaker: 0
        text: "\uB2F9\uC2E0\uC740 \uAC74\uB124\uBC1B\uC740 \uAC1C\uC694 \uD30C\uC77C\uC744
          \uD14C\uC774\uBE14 \uC704\uC5D0 \uD3BC\uCE58\uACE0, \uC0C8\uB85C \uCEE4\uD53C\uB97C
          \uD55C \uC794 \uC2DC\uCF30\uB2E4."
        expression: 0
        stageDirection: 
        reaction:
          clueId: 
          openDelay: 0
          window: 2.5
          expression: 3
          blurredFromRecallDepth: 2
        autoGrantClueId: 
      - speaker: 3
        text: "\uC815\uB9AC\uB294 \uC81C\uAC00 \uD560\uAC8C\uC694! \uC21C\uC11C\uB300\uB85C
          \uB193\uC544\uB458\uAE4C\uC694?"
        expression: 1
        stageDirection: 
        reaction:
          clueId: 
          openDelay: 0
          window: 2.5
          expression: 3
          blurredFromRecallDepth: 2
        autoGrantClueId: 
      - speaker: 1
        text: "\u2026\uADF8\uB300\uB85C \uB450\uC138\uC694. \uC7A0\uAE50 \uB2E4\uB140\uC624\uACA0\uC2B5\uB2C8\uB2E4."
        expression: 0
        stageDirection: 
        reaction:
          clueId: 
          openDelay: 0
          window: 2.5
          expression: 3
          blurredFromRecallDepth: 2
        autoGrantClueId: 
      - speaker: 0
        text: "\uB2F9\uC2E0\uC740 \uB9CC\uB144\uD544\uC744 \uC11C\uB958 \uBB49\uCE58
          \uC704\uC5D0 \uC62C\uB824\uB450\uACE0 \uC790\uB9AC\uB97C \uBE44\uC6E0\uB2E4."
        expression: 0
        stageDirection: 
        reaction:
          clueId: 
          openDelay: 0
          window: 2.5
          expression: 3
          blurredFromRecallDepth: 2
        autoGrantClueId: 
      - speaker: 2
