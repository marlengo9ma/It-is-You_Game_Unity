    endsInterrogation: 0
  onTokensExhausted:
    note: "[\uC784\uC2DC] \uD0C0\uC784 \uD1A0\uD070 \uC18C\uC9C4"
    lines:
    - speaker: 0
      text: "\uAE30\uCC28\uC758 \uD754\uB4E4\uB9BC\uC774 \uD55C \uBC15\uC790 \uB290\uB824\uC84C\uB2E4.
        \uB354 \uBD99\uC7A1\uACE0 \uC788\uC744 \uC2DC\uAC04\uC740 \uC5C6\uB2E4."
      expression: 0
      stageDirection: 
      reaction:
        clueId: 
        openDelay: 0
        window: 2.5
        expression: 3
        blurredFromRecallDepth: 2
      autoGrantClueId: 
    - speaker: 3
      text: "\u2026\uC800, \uC774\uC81C \uC815\uB9AC \uC880 \uB3C4\uC640\uB4DC\uB824\uB3C4
        \uB420\uAE4C\uC694?"
      expression: 2
      stageDirection: 
      reaction:
        clueId: 
        openDelay: 0
