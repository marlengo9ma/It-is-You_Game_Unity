  onEndInterrogation:
    note: "\uC138\uD53C \uC2EC\uBB38 \uB9C8\uBB34\uB9AC"
    lines:
    - speaker: 1
      text: "\uC77C\uB2E8 \uC54C\uC558\uC2B5\uB2C8\uB2E4. \uADF8\uB9AC\uACE0 \uC7A0\uC2DC\uB9CC
        \uAE30\uB2E4\uB824\uBCF4\uC2DC\uC8E0. \uC544\uC9C1 \uC774\uC57C\uAE30\uB97C
        \uB098\uB220\uC57C \uB420 \uBD84\uC774 \uB0A8\uC544\uACC4\uC2DC\uB2C8."
      expression: 0
      stageDirection: 
      reaction:
        clueId: 
        openDelay: 0
        window: 2.5
        expression: 3
        blurredFromRecallDepth: 2
      autoGrantClueId: 
    - speaker: 3
      text: "\uC774\uC57C\uAE30\uC694\u2026? \uC124\uB9C8 \uC774 \uACE0\uC591\uC774\uC694?!"
      expression: 6
      stageDirection: "(\uAC1C\uADF8 \uCEF7\uC52C?)"
