        window: 2.5
        expression: 3
        blurredFromRecallDepth: 2
      autoGrantClueId: 
    trustDelta: 0
    endsInterrogation: 0
  toneAlternationGameOver:
    note: "[\uC784\uC2DC] \uC131\uD5A5 \uAD50\uCC28 2\uD68C \u2014 \uAC8C\uC784\uC624\uBC84"
    lines:
    - speaker: 3
      text: "\u2026\uC218\uC0AC\uAD00\uB2D8, \uC9C0\uAE08 \uC800\uB97C \uB180\uB9AC\uC2DC\uB294
        \uAC74\uAC00\uC694?"
      expression: 4
      stageDirection: "(\uB2F9\uD639\uC744 \uB118\uC5B4\uC120 \uD45C\uC815\uC73C\uB85C
