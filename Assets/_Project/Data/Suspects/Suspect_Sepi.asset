    endsInterrogation: 0
  onEnterInterrogation:
    note: "\uC138\uD53C \uC2EC\uBB38 \uC2DC\uC791"
    lines:
    - speaker: 3
      text: "\uD558\uD558, \uB9CC\uB144\uD544\uC774\uB77C\u2026\uC8FC\uBCC0\uC5D0
