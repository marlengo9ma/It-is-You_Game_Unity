        clueId: 
        openDelay: 0
        window: 2.5
        expression: 3
        blurredFromRecallDepth: 2
      autoGrantClueId: 
    trustDelta: 0
    endsInterrogation: 0
  refusalByAnger:
    note: "[\uC784\uC2DC] \uC624\uBE0C\uC81D\uD2B8 \uBC18\uBCF5 \u2014 \uBD84\uB178"
    lines:
    - speaker: 3
      text: "\u2026\uACC4\uC18D \uB534 \uB370\uB9CC \uBCF4\uC2E4 \uAC70\uBA74, \uC800\uB294
        \uC774\uB9CC \uAC00\uBCF4\uACA0\uC2B5\uB2C8\uB2E4."
      expression: 4
      stageDirection: "(\uC790\uB9AC\uC5D0\uC11C \uC77C\uC5B4\uC120\uB2E4)"
      reaction:
        clueId: 
        openDelay: 0
        window: 2.5
        expression: 3
        blurredFromRecallDepth: 2
      autoGrantClueId: 
    trustDelta: 0
    endsInterrogation: 0
  toneAlternationWarning:
    note: "[\uC784\uC2DC] \uC131\uD5A5 \uAD50\uCC28 1\uD68C \u2014 \uC758\uBB38"
    lines:
    - speaker: 3
      text: "\u2026\uC5B4, \uC800\uAE30, \uC218\uC0AC\uAD00\uB2D8? \uAD1C\uCC2E\uC73C\uC2E0
