  id: SEPI
  displayName: "\uC138\uD53C"
  speaker: 3
  profile: "\uC784\uC2DC \uBC30\uCE58\uB41C \uBCF4\uC870 \uC218\uC0AC\uAD00. \uC11C\uB958\uC0C1
    '\uC21C\uAC04 \uAE30\uC5B5 \uB2A5\uB825'\uACFC '\uC18D\uAE30\uC0AC' \uC790\uACA9\uC774
    \uAE30\uC7AC\uB418\uC5B4 \uC788\uC73C\uBA70, \uADF8 \uC911 \uC21C\uAC04 \uAE30\uC5B5
    \uB2A5\uB825\uC5D0\uB294 \uACF5\uC778 \uB3C4\uC7A5\uC774 \uCC0D\uD600 \uC788\uB2E4.\n\uC2DC\uAC04
    \uC57D\uC18D\uC5D0 \uB300\uD55C \uAC1C\uB150\uC774 \uBD80\uC871\uD568."
