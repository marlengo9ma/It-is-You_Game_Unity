      reaction:
        clueId: 
        openDelay: 0
        window: 2.5
        expression: 3
        blurredFromRecallDepth: 2
      autoGrantClueId: 
    - speaker: 0
      text: "\uC2E0\uB8B0\uB97C \uC783\uC5C8\uB2E4. \uC774 \uC0C1\uD0DC\uB85C\uB294
        \uC5B4\uB5A4 \uC9C4\uC220\uB3C4 \uBC1B\uC544\uB0BC \uC218 \uC5C6\uB2E4."
      expression: 0
      stageDirection: 
      reaction:
        clueId: 
        openDelay: 0
        window: 2.5
        expression: 3
        blurredFromRecallDepth: 2
      autoGrantClueId: 
