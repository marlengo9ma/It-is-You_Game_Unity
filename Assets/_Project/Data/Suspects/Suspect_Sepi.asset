        \uB2F5\uD558\uC9C0 \uBABB\uD588\uB2E4."
      expression: 0
      stageDirection: 
      reaction:
        clueId: 
        openDelay: 0
        window: 2.5
        expression: 3
        blurredFromRecallDepth: 2
      autoGrantClueId: 
