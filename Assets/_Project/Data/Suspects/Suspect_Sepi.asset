  objectSpamWarning:
    note: "[\uC784\uC2DC] \uC624\uBE0C\uC81D\uD2B8 \uBC18\uBCF5 \uACBD\uACE0"
    lines:
    - speaker: 3
      text: "\uC800\u2026 \uC800\uD55C\uD14C \uBB3C\uC5B4\uBCF4\uC2E4 \uAC74 \uC5C6\uC73C\uC2E0\uAC00\uC694?"
