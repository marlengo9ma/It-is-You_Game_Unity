  id: CLUE_NEWSPAPER
  kind: 0
  unreadName: "\uC2E0\uBB38"
  readName: "\uC624\uB298\uC790 \uC2E0\uBB38"
  tooltip: "\uAE30\uCC28\uC5ED\uC5D0\uC11C \uAD6C\uB9E4\uD588\uB358 \uC624\uB298\uC790
    \uC2E0\uBB38\uC774\uB2E4. \n\uD3BC\uCCD0\uC9C4 \uC2E0\uBB38\uC758 \uD398\uC774\uC9C0\uC758
    \uD55C \uCABD\uC5D0\uB294 \uCD5C\uADFC \uB300\uB450\uB418\uB294 \uC2E0\uC885
    \uBC94\uC8C4 \uC0AC\uAC74\uC5D0 \uAD00\uB828\uB41C \uC774\uC57C\uAE30\uB97C \uB2E4\uB8E8\uACE0
    \uC788\uB2E4.\n\n\uCD5C\uCCA8\uB2E8 \uAE30\uC220\uC774\uB77C\uACE0 \uC790\uBD80\uD558\uB358
    \uACFC\uD559 \uC218\uC0AC, \uC8C4 \uC5C6\uB294 \uC774\uC5D0\uAC8C \uC0AC\uD615\uC744?\n\n\uCD5C\uADFC
    \uAE09\uC9C4\uC801\uC778 \uC0B0\uC5C5\uC758 \uBC1C\uB2EC\uB85C \uC778\uD574\uC11C
    \uC6B0\uB9AC\uB4E4\uC740 \uADC0\uC871 \uD3C9\uBBFC \uD560 \uAC83 \uC5C6\uC774
    \uC77C\uC0C1\uC758 \uC0C8\uB85C\uC6C0\uC744 \uB290\uB07C\uACE0 \uC788\uC74C\uC740
    \uC544\uBB34\uB3C4 \uBD80\uC815\uD558\uC9C0 \uBABB\uD560 \uAC83\uC774\uB2E4.
    \uB9D0 \uB300\uC2E0 \uB3CC\uC744 \uB123\uC5B4\uC11C \uCCA0\uAE38 \uC704\uB97C
    \uB2EC\uB9AC\uB294 \uBB34\uC1E0\uB85C \uB41C \uB9C8\uCC28\uC640 \uBD88\uC548\uD588\uB358
    \uC5B4\uB450\uC6B4 \uACE8\uBAA9\uC5D0 \uBD88\uBE5B\uC744 \uCF1C\uC900 \uAC00\uB85C\uB4F1
    \uB4F1, \uC6B0\uB9AC\uB4E4\uC740 \uC77C\uC0C1\uC0DD\uD65C\uC5D0\uC11C \uC810\uC810
    \uD3B8\uB9AC\uC640 \uD3B8\uC548\uC744 \uBCF4\uB2E4 \uC27D\uAC8C \uB290\uB084
    \uC218 \uC788\uAC8C \uB418\uC5C8\uB2E4. \n\uD558\uC9C0\uB9CC \uB3D9\uC2DC\uC5D0
    \uC774\uB7F0 \uAE30\uC220\uC758 \uBC1C\uC804\uC744 \uC774\uC6A9\uD55C \uC0C8\uB85C\uC6B4
    \uBC29\uC2DD\uC758 \uBC94\uC8C4\uB4E4\uB3C4 \uC0DD\uACA8\uB098\uAE30 \uC2DC\uC791\uD558\uBA70,
    \uADC0\uC871\uC740 \uADC0\uC871\uB300\uB85C, \uC77C\uBC18 \uC2DC\uBBFC\uB3C4
    \uC2DC\uBBFC\uB300\uB85C \uC774\uB7F0 \uC2E0\uC885\uBC94\uC8C4\uC5D0 \uB178\uCD9C\uB418\uC5B4
    \uBC84\uB838\uB2E4. \n\uADF8\uB798\uB3C4 \uC6B0\uB9AC\uC758 \uB300\uB2E8\uD55C
    \uACBD\uCC30\uBD84\uB4E4\uC740 \uC2DC\uBBFC\uC758 \uBD88\uC548\uD568\uC744 \uD574\uC18C\uD558\uACE0\uC790,
    \uBC94\uC8C4 \uC218\uC0AC\uAD00\uB828\uD574\uC11C\uB3C4 \uC5EC\uB7EC \uC0C8\uB85C\uC6B4
    \uBC29\uC2DD\uC744 \uC5F0\uAD6C\uD558\uC600\uACE0 \uC774\uC5D0 \uB530\uB77C \uB2E4\uC591\uD55C
    \uC2E4\uD5D8\uC801\uC778 \uC218\uC0AC\uD300\uC774 \uAFB8\uB824\uC838 \uC788\uB294
    \uAC83\uC5D0 \uB300\uD574\uC11C\uB294 \uC774\uC81C\uB294 \uBAA8\uB450\uAC00 \uC54C
    \uAC83\uC774\uB77C \uC0DD\uAC01\uD55C\uB2E4. \n\uD5C8\uB098 \uD608\uD754 \uAC80\uC0AC,
    \uC9C0\uBB38 \uAC10\uC2DD \uB4F1, \uD3C9\uBBFC\uC740 \uBB3C\uB860 \uADC0\uC871\uC5D0\uAC8C
    \uC870\uCC28 \uC0DD\uC18C\uD55C \u2018\uACFC\uD559\u2019\uC774\uB77C\uB294 \uBD84\uC57C\uAC00
    \uBC1C\uB2EC\uD558\uBA74\uC11C \uC0C8\uB86D\uAC8C \uC0DD\uACA8\uB09C \uACFC\uD559\uC218\uC0AC
    \uBC29\uC2DD\uC740, \uAE30\uC874\uC758 \uC218\uC0AC\uBC29\uBC95\uACFC\uB294 \uCC28\uC774\uAC00
    \uCEF8\uB2E4.\n\uC774 \uD608\uC561 \uAC80\uC0AC\uB098 \uC9C0\uBB38 \uAC10\uC2DD
    \uB4F1\uC758 \uADF8\uB4E4\uC774 \uB9D0\uD558\uACE0 \uC788\uB294 \u2018\uACFC\uD559\uC801
    \uC218\uC0AC \uBC29\uC2DD\u2018\uB4E4\uC740 \uC6B0\uB9AC\uB4E4\uC5D0\uAC90 \uADF8\uC800
    \uBAB0\uC544\uAC00\uAE30 \uC2DD\uC758 \uB9C8\uB140 \uC0AC\uB0E5\uACFC \uAC19\uB2E4.
    \uAE30\uB4DD\uAD8C\uCE35\uC758 \uBA85\uBAA9\uC744 \uB0B4\uC0C8\uC6B0\uAE30 \uC704\uD574
    \uADF8\uB7F4 \uB4EF\uD558\uAC8C \uBCF4\uC774\uB294 \uB0B4\uC6A9\uB9CC\uC744 \uAC00\uC9C0\uACE0
    \uCC98\uBC8C\uC744 \uD558\uB294 \uAC83\uC740 \uBD88\uD3C9\uB4F1\uD558\uACE0 \uBB54\uAC00
    \uC798\uBABB\uB418\uC5C8\uB2E4.\n\uC2EC\uC9C0\uC5B4 \uCF67\uB300 \uB192\uC73C\uC2E0
    \uADC0\uC871\uB4E4\uB3C4 \uADF8\uB807\uAC8C \uC0DD\uAC01\uD560 \uC815\uB3C4\uBA74
    \uB354\uC6B1\uC774 \uC798\uBABB\uB41C \uAC83\uC774 \uC544\uB2D0\uAE4C.\n\uD53C\uB294
    \uAC19\uAC70\uB098 \uBE44\uC2B7\uD55C \uC0AC\uB78C\uB3C4 \uC788\uB2E4\uBA74\uC11C
    \uC190\uAC00\uB77D \uB05D\uC5D0\uB294 \uC218 \uB9CC\uBA85\uC758 \uC0AC\uB78C\uB9C8\uB2E4
    \uAC01 \uACE0\uC720\uC758 \uB2E4\uB978 \uBAA8\uC591\uC774 \uC788\uB2E4\uACE0
    \uD558\uB294 \uAC83\uB3C4 \uBBFF\uAE30 \uC5B4\uB824\uC6B4\uB370, \uC5BC\uB9C8
    \uC804\uC5D0\uB294 \uC774 \u2018\uC9C0\uBB38 \uAC80\uC2DD\u2019 \uC218\uC0AC
    \uBC29\uBC95\uC744 \uC0AC\uC6A9\uD558\uB358 \uC218\uC0AC\uD300\uC774 \uC5C4\uD55C
    \uC0AC\uB78C\uC744 \uBC94\uC778\uC73C\uB85C \uC9C0\uBAA9\uD574\uC11C \uC0AC\uD615\uC2DC\uD0A4\uBED4
    \uD558\uAE30\uB3C4 \uD588\uB2E4!\n\n\uC774\uB807\uAC8C \uC218\uC0AC \uACFC\uC815\uC5D0\uC11C
    \uC624\uB958\uB3C4 \uC788\uB294 \uBC29\uBC95\uC740 \uADF8\uB4E4\uB9CC\uC758 \uC88B\uC740
    \uD551\uACC4\uAC70\uB9AC\uB77C\uACE0 \uBC16\uC5D0 \uC0DD\uAC01\uC774 \uB4E4\uC9C0
    \uC54A\uB294\uB2E4. \uB208\uC5D0 \uC798 \uBCF4\uC774\uC9C0\uB3C4 \uC54A\uB294
    \uAC78 \uC99D\uAC70\uB85C \uC0BC\uC544 \uBC94\uC778\uC73C\uB85C \uC774\uC57C\uAE30\uD558\uB294
    \uAC83\uB3C4 \uC6C3\uAE34\uB370, \uBAA8\uB974\uB294 \uC0AC\uB78C \uC785\uC7A5\uC5D0\uC11C\uB294
    \uADF8\uB7F4\uB4EF \uD55C \uB9D0\uC744 \uC774\uC720\uB85C \uC9C0\uC5B4\uB0B4\uC11C
    \uC5C4\uD55C \uC0AC\uB78C\uC744 \uBC94\uC778\uC73C\uB85C \uBAB0\uC544\uAC00\uB294
    \uAC83\uCC98\uB7FC\uBC16\uC5D0 \uC548 \uB290\uAEF4\uC9C0\uB294 \uAC74 \uACFC\uC5F0
    \uC6B0\uB9AC\uC758 \uD0D3\uC77C\uAE4C?\n\uADF8\uC5D0 \uBE44\uD574\uC11C \uC6B0\uB9AC\uB4E4\uC758
    \uC601\uC6C5, \u2019\uD45C\uC815 \uD589\uB3D9 \uC218\uC0AC\uD300\u2019\uC740
    \uB2EC\uB790\uB2E4! \n\uC9C1\uAD00\uC801\uC778 \uAC80\uC2DC \uBC0F \uBC95\uC758\uD559
    \uACBD\uD5D8\uACFC \uAD6C\uC0C9, \uC120\uC870\uC5D0\uC11C \uBD80\uD130 \uB0B4\uB824\uC628
    \uACBD\uD5D8\uB4E4\uACFC \uACFC\uAC70\uC758 \uD1B5\uACC4 \uC218\uCE58\uB97C \uD65C\uC6A9\uD55C
    \uC2EC\uBB38\uACFC \uBCC0\uD638\uB294 \uBB34\uACE0\uD55C \uC790\uC758 \uACB0\uBC31\uC744
    \uBC1D\uD788\uAC70\uB098 \uC9C0\uB3C5\uD55C \uBC94\uC8C4\uC790\uC5D0\uAC8C\uC11C
    \uC790\uBC31\uC744 \uC774\uB04C\uC5B4\uB0B4\uAE30\uB3C4 \uD6A8\uC728\uC801\uC774\uB2E4!\n\uC2EC\uC9C0\uC5B4
    \uC704\uC758 \uC9C0\uBB38 \uAC10\uC2DD \uC218\uC0AC \uBC29\uC2DD\uC744 \uAC00\uC9C0\uACE0
    \uBB34\uACE0\uD55C \uC774\uB97C \uBC94\uC778 \uC9C0\uBAA9\uC744 \uD588\uB358
    \uC0AC\uAC74\uC5D0\uC11C\uB3C4 \u2018\uD45C\uC815 \uD589\uB3D9 \uC218\uC0AC\uACFC\u2019\uC5D0\uC11C
    \uC81C\uB300\uB85C \uB41C \uBC94\uC778\uC5D0\uAC8C\uC11C \uC790\uC218\uB97C \uBC1B\uC544
    \uD574\uACB0\uD558\uC9C0 \uC54A\uC558\uB294\uAC00!\n\uB098\uB294 \uC774 \uD45C\uC815
    \uD589\uB3D9 \uC218\uC0AC \uBC29\uC2DD\uC774\uC57C\uB9D0\uB85C \uC624\uD788\uB824
    \uADF8\uB4E4\uC774 \uB9D0\uD588\uB358 \u2018\uACFC\uD559\u2019\uC774\uB77C\uB294
    \uAC83\uC5D0 \uB354\uC6B1 \uAC00\uAE4C\uC6B4\uAC8C \uC544\uB2D0\uAE4C \uD544\uC790\uB294
    \uC0DD\uAC01\uD55C\uB2E4.\n(\uC774\uD558 \uC0DD\uB7B5)"
