  unreadName: "\uCEE4\uD53C\uC794"
  readName: "\uC5CE\uC9C8\uB7EC\uC84C\uB358 \uCEE4\uD53C\uC794"
  tooltip: "\uB2F9\uC2E0\uC774 \uAE30\uCC28\uC5D0 \uC62C\uB77C, \uC0C8\uB85C\uC774
    \uC2DC\uCF30\uB358 \uCEE4\uD53C\uC758 \uB9D0\uB85C\uC774\uB2E4.\n\n\uB2E4\uD589\uD788
    \uC794\uC5D0 \uAE08\uC774 \uAC00\uAC70\uB098 \uAE68\uC838 \uBCF4\uC774\uC9C0\uB294
    \uC54A\uC9C0\uB9CC \uADF8 \uC548\uC5D0 \uC788\uB358 \uB0B4\uC6A9\uBB3C\uC758
    \uD589\uBC29\uC740 \uAC1D\uC2E4\uB0B4 \uD14C\uC774\uBE14 \uC704\uC758 \uAC01\uC885
    \uC2E0\uBB38, \uC11C\uB958\uB4E4\uACFC, \uC8FC\uBCC0 \uBC14\uB2E5\uC5D0\uC11C
    \uD655\uC778\uC774 \uAC00\uB2A5\uD588\uB2E4.\n\n<hl>\uC544\uB9C8\uB3C4 \uB204\uAD70\uAC00\uAC00
    \uAE09\uD558\uAC8C \uC6C0\uC9C1\uC774\uBA74\uC11C \uC2E4\uC218\uB97C \uD588\uAC70\uB098,
    \uC790\uC720\uBD84\uBC29\uD558\uACE0 \uBE60\uB974\uAC8C \uC6C0\uC9C1\uC774\uB294
    \uBB34\uC5B8\uAC00\uC5D0 \uC758\uD574 \uC3DF\uC544\uC84C\uC744 \uAC83\uC774\uB2E4.</hl>"
