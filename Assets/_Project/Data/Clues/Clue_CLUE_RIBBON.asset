  unreadName: "\uB9AC\uBCF8 \uB048"
  readName: "\uC5BC\uB8E9\uC9C0\uACE0 \uD5E4\uC9C4 \uACE0\uAE09 \uB9AC\uBCF8"
  tooltip: "\uB2F9\uC2E0\uC774 \uC120\uBB3C \uC6A9\uB3C4\uB85C \uAD6C\uB9E4\uD588\uB358
    \uD734\uB300\uC6A9 \uD0C0\uC790\uAE30\uC5D0 \uC57D\uAC04(?)\uC758 \uC815\uC131\uACFC
    \uC131\uC758\uC758 \uD45C\uC2DC\uB97C \uC704\uD574 \uBCC4\uB3C4\uB85C \uAD6C\uB9E4\uD588\uB358
    \uBD89\uC740\uC0C9\uC758 \uACE0\uAE09 \uB9AC\uBCF8\uC774\uB2E4. \uBB3C\uB860
    \uD3EC\uC7A5 \uB9AC\uBCF8\uC744 \uBB36\uC744 \uC904 \uBAB0\uB790\uB358 \uB2F9\uC2E0\uC740
    \uC5EC\uB7EC \uBC88\uC758 \uC2DC\uB3C4 \uB05D\uC5D0 \uAE08\uC0C8 \uD3EC\uAE30\uD588\uC9C0\uB9CC.\n\n\uAE30\uCC28\uC5ED
    \uD14C\uC774\uBE14\uC5D0 \uB450\uACE0 \uC628 \uC904 \uC54C\uC558\uC73C\uB098,
    <hl>\uC870\uC218\uAC00 \uD0C0\uC790\uAE30\uB97C \uAC00\uC838\uC624\uBA74\uC11C
    \uAC19\uC774 \uCC59\uAE34 \uB4EF \uD558\uB2E4.</hl>\n\n\uC9C0\uAE08\uC740 \uC77C\uBD80\uBD84\uC774
    \uC561\uCCB4\uC5D0 \uC758\uD574 \uC5BC\uB8E9\uC84C\uC73C\uBA70, <hl>\uB4DC\uBB38\uB4DC\uBB38
    \uD5E4\uC9C4 \uACF3\uACFC \uACE0\uC591\uC774 \uD138\uC774 \uBC15\uD600\uC788\uB294
    \uAC83</hl>\uC774 \uBCF4\uC778\uB2E4."
