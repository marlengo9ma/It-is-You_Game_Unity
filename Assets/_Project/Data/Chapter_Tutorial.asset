  afterCutsceneTalk:
    note: "\uC0AC\uAC74 \uC774\uC804 \u2014 \uBCF5\uB3C4"
    lines:
    - speaker: 1
      text: "\u2026\uADF8\uB7EC\uB2C8\uAE4C \uC870\uC2EC \uC880 \uD558\uB77C\uB2C8\uAE4C."
