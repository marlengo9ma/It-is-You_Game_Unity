  interrogationTitleFormat: "\uC6A9\uC758\uC790 \u2018{name}\u2019 \uC2EC\uBB38 \uC2DC\uC791"
  tutorialPopups:
  - id: POPUP_1
    title: "1\uCC28 \uC2EC\uBB38 \uD398\uC774\uC988 \u2014 \uD29C\uD1A0\uB9AC\uC5BC
      1"
    trigger: 1
    pages:
    - "\uAE30\uBCF8\uC801\uC73C\uB85C \uC8FC\uC778\uACF5\uACFC \uC6A9\uC758\uC790\uC758
      \uB300\uD654\uB85C \uC9C4\uD589\uB418\uBA70, \uAC01 \uC6A9\uC758\uC790\uB9C8\uB2E4
      \uC81C\uD55C\uB41C \uC591\uC758 [\uD0C0\uC784 \uD1A0\uD070]\uC774 \uC8FC\uC5B4\uC9D1\uB2C8\uB2E4.\n\n>>[\uD0C0\uC784
      \uD1A0\uD070]\uC740 \uAE30\uBCF8\uC801\uC73C\uB85C \uD50C\uB808\uC774\uC5B4\uC758
      \uD589\uB3D9\uC5D0 \uB530\uB77C \uC18C\uBAA8\uB418\uBA70, \uC774\uC5D0 \uB530\uB77C\uC11C
      \uC2EC\uBB38/\uB2E8\uC11C \uC870\uD569 \uD398\uC774\uC988\uAC00 \uC9C4\uD589\uB429\uB2C8\uB2E4."
    - "[\uC2EC\uBB38 \uD398\uC774\uC988]\uC5D0 \uC9C4\uC785 \uC2DC, \uD654\uBA74
      \uC88C\uCE21\uC5D0 \uB098\uC5F4\uB41C <\uBA54\uC778 \uC120\uD0DD\uC9C0>\uB97C
      \uC88C\uD074\uB9AD\uC744 \uD1B5\uD574 \uC120\uD0DD\uD558\uC5EC \uC2EC\uBB38\uC744
      \uC9C4\uD589\uD558\uAC70\uB098, [\uC2EC\uBB38 \uD398\uC774\uC988] \uD654\uBA74\uB0B4\uC5D0\uC11C
      \uD2B9\uC218 \uC624\uBE0C\uC81D\uD2B8 \uC694\uC18C\uC778, <\uC2EC\uBB38 \uC624\uBE0C\uC81D\uD2B8>\uB97C
      \uC88C\uD074\uB9AD\uD558\uC5EC \uBA54\uC778 \uC120\uD0DD\uC9C0\uC640\uB294
      \uBCC4\uAC1C\uC758 \uB300\uD654\uB97C \uC9C4\uD589\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    - "<\uBA54\uC778 \uC120\uD0DD\uC9C0>\uC5D0\uB294 \uAE30\uBCF8\uC801\uC73C\uB85C
      \u2019\uACBD\uACC4\uB3C4\uB97C \uB0AE\uCD94\uBA70 \uC790\uC5F0\uC2A4\uB7FD\uAC8C
      \uB300\uD654\uB97C \uC774\uB04C\uC5B4\uB0B4\uB294 <\uCE5C\uADFC \uC120\uD0DD\uC9C0>\u2018\uC640
      \u2019\uCD94\uAD81\uD558\uAC70\uB098 \uAC15\uC555\uC801\uC73C\uB85C \uC555\uBC15\uD558\uBA70
      \uC2EC\uBB38\uD558\uB294 <\uAC15\uC555 \uC120\uD0DD\uC9C0>\u2018\uAC00 \uC0DD\uC131\uB429\uB2C8\uB2E4.
      \n\n>>\uC55E\uC11C [\uB2E8\uC11C \uC218\uC9D1 \uD398\uC774\uC988]\uC5D0\uC11C
      \uC218\uC9D1\uD55C \uD2B9\uC815 \uB2E8\uC11C\uC758 \uC720\uBB34\uC5D0 \uB530\uB77C\uC11C\uB3C4
      \uC120\uD0DD\uC9C0\uAC00 \uCD94\uAC00\uB418\uAC70\uB098, \uAE30\uBCF8 \uBA54\uC778
      \uC120\uD0DD\uC9C0\uC758 \uD14D\uC2A4\uD2B8\uAC00 \uBCC0\uACBD\uB420 \uC218
      \uC788\uC2B5\uB2C8\uB2E4."
    - ">>\uD2B9\uC815\uD55C \uB300\uD654 \uD639\uC740 \uC2EC\uBB38\uC758 \uC9C4\uD589
      \uBC0F \uC2DC\uAC04\uC758 \uD750\uB984(\uD0C0\uC784 \uD1A0\uD070\uC758 \uC794\uC5EC\uB7C9)
      \uB4F1, \uD2B9\uC815 \uD2B8\uB9AC\uAC70\uC5D0 \uB530\uB77C\uC11C \uD654\uBA74
      \uC88C\uCE21\uC5D0 \uC120\uD0DD\uC9C0\uC5D0 \uBCC4\uB3C4\uC758 \uC120\uD0DD\uC9C0\uAC00
      \uCD94\uAC00\uB85C \uC0DD\uC131\uB418\uAE30\uB3C4 \uD569\uB2C8\uB2E4. \n\n>>
      \uAE30\uBCF8\uC801\uC73C\uB85C \uC8FC\uC5B4\uC9C0\uB294 \uC120\uD0DD\uC9C0\uC640,
      \uD2B9\uC815 \uD2B8\uB9AC\uAC70 \uBC0F \uC9C4\uD589\uC5D0 \uB530\uB77C \uCD94\uAC00/\uBCC0\uACBD\uB418\uB294
      \uC120\uD0DD\uC9C0\uB97C \uD3EC\uD568\uD558\uC5EC, \uC6A9\uC758\uC790\uB9C8\uB2E4
      \uCD5C\uC18C 2\uAC00\uC9C0\uC5D0\uC11C \uCD5C\uB300 5\uAC00\uC9C0\uC758 \uC120\uD0DD\uC9C0\uAC00
      \uC0DD\uC131/\uBCC0\uACBD\uB420 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
  - id: POPUP_2
    title: "1\uCC28 \uC2EC\uBB38 \uD398\uC774\uC988 \u2014 \uD29C\uD1A0\uB9AC\uC5BC
      2"
    trigger: 2
    pages:
    - "\uBA54\uC778 \uC120\uD0DD\uC9C0 \uC120\uD0DD \uBC0F \uC2EC\uBB38 \uC624\uBE0C\uC81D\uD2B8
      \uC120\uD0DD \uC2DC, \uD574\uB2F9 \uC120\uD0DD\uC9C0 \uD639\uC740 \uC624\uBE0C\uC81D\uD2B8\uC5D0
      \uB300\uD55C \uBC18\uC751\uC774 \uC6A9\uC758\uC790\uC5D0\uAC8C\uC11C \uB098\uD0C0\uB098\uBA70,
      \uC8FC\uC778\uACF5\uACFC \uC6A9\uC758\uC790 \uAC04\uC758 \uC2EC\uBB38 \uBC0F
      \uB300\uD654\uAC00 \uC9C4\uD589\uB429\uB2C8\uB2E4.\n\n>> \uB300\uD654 \uC911\uC5D0
      \uBC11\uC904\uC774 \uADF8\uC5B4\uC838\uC788\uB294 \uD2B9\uC815 \uB2E8\uC5B4\uB098
      \uBB38\uC7A5 \uD45C\uD604\uC744 \uD074\uB9AD\uD558\uBA74 [\uC99D\uC5B8 \uBC0F
      \uC815\uD669 \uC99D\uAC70]\uB85C\uC368 \uC218\uC9D1\uC774 \uAC00\uB2A5\uD574\uC9C0\uBA70,
      \uC6B0\uCE21\uC758 \uB2E8\uC11C \uBAA9\uB85D\uC5D0 \uCD94\uAC00\uB429\uB2C8\uB2E4."
    - "\uC8FC\uC778\uACF5\uC758 \uB300\uC0AC \uBC0F \uD589\uB3D9\uC5D0 \uB530\uB77C,
      \uC6A9\uC758\uC790 \uCE90\uB9AD\uD130\uC5D0\uAC8C\uC11C\uB294 \uB180\uB77C\uAC70\uB098
      \uB3D9\uACF5\uC774 \uB5A8\uB9AC\uB294 \uB4F1, \uC77C\uBC18\uC801\uC774\uC9C0
      \uC54A\uC740 \uBC18\uC751\uC778 <\uB9AC\uC561\uC158>\uC774 \uB098\uD0C0\uB098\uAE30\uB3C4
      \uD569\uB2C8\uB2E4.\n\n>>\uD2B9\uC815 <\uB9AC\uC561\uC158>\uC774 \uB098\uD0C0\uB0AC\uC744
      \uB54C\uC5D0 \uB300\uC0AC\uAC00 \uC9C4\uD589\uB420 \uB3D9\uC548 \uC6A9\uC758\uC790
      \uCE90\uB9AD\uD130 \uC704\uB85C \uB9C8\uC6B0\uC2A4 \uC624\uBC84\uC2DC, \uCEE4\uC11C
      \uC774\uBBF8\uC9C0\uAC00 \uC77C\uC2DC\uC801\uC73C\uB85C \uBC14\uB00C\uAC8C
      \uB418\uBA70, \uD574\uB2F9 \uD0C0\uC774\uBC0D\uC5D0 \uC88C\uD074\uB9AD \uC2DC,
      \uD574\uB2F9 \uD589\uB3D9\uC744 [\uC99D\uC5B8 \uBC0F \uC815\uD669 \uB2E8\uC11C]\uB85C\uC368
      \uC218\uC9D1\uC774 \uB429\uB2C8\uB2E4."
    - "\uBA54\uC778 \uC120\uD0DD\uC9C0\uB294 \uAC19\uC740 \uC120\uD0DD\uC9C0\uB354\uB77C\uB3C4
      \uC911\uBCF5\uD558\uC5EC \uC5EC\uB7EC \uBC88 \uC120\uD0DD\uC774 \uAC00\uB2A5\uD569\uB2C8\uB2E4.
      \uACBD\uC6B0\uC5D0 \uB530\uB77C, \uC911\uBCF5\uB418\uB294 \uC120\uD0DD\uC9C0\uB97C
      \uC120\uD0DD\uD558\uB354\uB77C\uB3C4 \uB2E4\uB978 \uB0B4\uC6A9\uC758 \uC2EC\uBB38\uC744
      \uC774\uC5B4\uAC08 \uC218 \uC788\uC2B5\uB2C8\uB2E4. \n\n>>\uC774 \uC870\uAC74\uC774
      \uCDA9\uC871\uB41C \uACBD\uC6B0\uC5D0\uB294 \uC774\uBBF8 \uC120\uD0DD\uD588\uC5C8\uB358
      \uBA54\uC778 \uC120\uD0DD\uC9C0 \uC704\uB85C, \uBCC4\uB3C4\uB85C \uC544\uC774\uCF58\uC774
      \uD45C\uC2DC \uB429\uB2C8\uB2E4."
  - id: POPUP_3
    title: "1\uCC28 \uC2EC\uBB38 \uD398\uC774\uC988 \u2014 \uD29C\uD1A0\uB9AC\uC5BC
      3"
    trigger: 5
    pages:
    - "\uD2B9\uC815 \uC120\uD0DD\uC9C0\uB098 \uC9C8\uBB38\uC5D0 \uB300\uD55C \uBC18\uC751
      \uBC0F \uB300\uD654\uB97C \uB3CC\uC544\uBCFC \uB54C\uC5D0\uB294 [\uAE30\uC5B5
      \uC9D0\uC791]\uC744 \uC9C4\uD589\uD569\uB2C8\uB2E4.\n\n>>[\uAE30\uC5B5 \uC9D0\uC791]\uD1B5\uD574
      \uC55E\uC11C \uC6A9\uC758\uC790\uC640 \uB098\uB204\uC5C8\uB358 \uB300\uD654
      \uB0B4\uC6A9\uC774\uB098 \uC6A9\uC758\uC790\uC758 \uB9AC\uC561\uC158\uC744
      \uD750\uB9BF\uD574\uC9C4 \uD654\uBA74\uC73C\uB85C \uB2E4\uC2DC \uBCFC \uC218
      \uC788\uC2B5\uB2C8\uB2E4. "
    - "\uAE30\uC5B5 \uC9D0\uC791\uC740 \uC2EC\uBB38 \uD398\uC774\uC988 \uC911\uC5D0
      \uC5EC\uB7EC \uBC88 \uC9C4\uD589 \uD560 \uC218 \uC788\uC73C\uB098, \uD69F\uC218\uC5D0
      \uB530\uB77C \uB354\uC6B1 \uBD88\uBD84\uBA85\uD55C \uB0B4\uC6A9\uACFC \uC778\uC601,
      \uC65C\uACE1\uB41C \uB0B4\uC6A9\uB4E4\uB85C \uBCF4\uC5EC\uC9D1\uB2C8\uB2E4.\n\n>>\uAE30\uC5B5
      \uC9D0\uC791 \uC911\uC5D0\uB3C4 \uB3D9\uC77C\uD55C \uC0C1\uD638 \uC791\uC6A9\uC744
      \uD1B5\uD574\uC11C  \u2018\uC99D\uC5B8 \uBC0F \uC815\uD669 \uB2E8\uC11C\u2019\uB97C
      \uC218\uC9D1\uD560 \uC218 \uC788\uC73C\uB098, \uC77C\uBD80 \uD750\uB9BF\uD574\uC9C4
      \uD45C\uC815 \uB9AC\uC561\uC158\uC774\uB098 \uC65C\uACE1\uB41C \uD14D\uC2A4\uD2B8\uC5D0\uC11C\uB294
      \uC218\uC9D1\uC774 \uBD88\uAC00\uB2A5\uD574\uC9D1\uB2C8\uB2E4."
  - id: POPUP_PENALTY
    title: "\uD0C0\uC784 \uD1A0\uD070\uACFC \uD398\uB110\uD2F0"
    trigger: 4
    pages:
    - "[\uD0C0\uC784 \uD1A0\uD070]\uC740 \uAC8C\uC784\uB0B4\uC5D0\uC11C\uC758 \uC2DC\uAC04\uC744
      \uD1A0\uD070\uC73C\uB85C \uC2DC\uAC01\uD654 \uD55C \uC694\uC18C\uC774\uBA70,
      \uAC01 \uD398\uC774\uC988\uC5D0 \uD560\uB2F9\uB41C \uD0C0\uC784 \uD1A0\uD070\uC774
      \uC804\uBD80 \uC18C\uC9C4\uB418\uBA74 \uD574\uB2F9 \uD398\uC774\uC988\uAC00
      <\uAC15\uC81C \uC885\uB8CC>\uB41C\uB2E4.\n\n\uD0C0\uC784 \uD1A0\uD070\uC740
      \uD50C\uB808\uC774\uC5B4\uC758 \uB2E4\uC74C\uACFC \uAC19\uC740 \uD589\uB3D9\uC73C\uB85C
      \uC18C\uBAA8\uB41C\uB2E4.\n\xB7 \uC120\uD0DD\uC9C0 \uC120\uD0DD&\uC7AC\uC120\uD0DD
      \uC2DC (\uC2EC\uBB38 \uD398\uC774\uC988)\n\xB7 \uC2EC\uBB38 \uC624\uBE0C\uC81D\uD2B8
      \uC120\uD0DD \uC2DC (\uC2EC\uBB38 \uD398\uC774\uC988)\n\xB7 30\uCD08 \uAC04\uC758
      \uBBF8\uD589\uB3D9\uC73C\uB85C \uC778\uD55C \uBB34\uBC18\uC751 \uD310\uC815
      \uC2DC (\uC2EC\uBB38 \uD398\uC774\uC988)\n\xB7 \uD68C\uC0C1 \uAE30\uB2A5 \uB0B4\uC5D0\uC11C\uC758
      \u2018\uC870\uC218\uC758 \uB3C4\uC6C0(\uC57D\uC5B4 \uBBF8\uC815)\u2018 \uC0AC\uC6A9
      \uC2DC (\uC2EC\uBB38 \uD398\uC774\uC988)\n\xB7 \uC2A4\uD1A0\uB9AC \uC9C4\uD589\uC73C\uB85C
      \uC778\uD55C \uAC15\uC81C \uB300\uD654 \uC9C4\uD589 \uC2DC (\uC2EC\uBB38 \uD398\uC774\uC988)"
    - "\uB2E4\uC74C\uACFC \uAC19\uC740 \uD589\uB3D9\uC73C\uB85C \uD0C0\uC784 \uD1A0\uD070\uC758
      \uC794\uC5EC\uB7C9\uACFC \uBCC4\uAC1C\uB85C \uC804\uB7C9 \uC18C\uC9C4\uB41C\uB2E4.\n\n\uACFC\uB3C4\uD55C
      <\uAC15\uC555 \uC120\uD0DD\uC9C0>\uC758 \uC7AC\uC120\uD0DD \uD639\uC740 \uC0AC\uAC74\uACFC\uB294
      \uB3D9 \uB5A8\uC5B4\uC9C4 \uC9C8\uBB38\uB4E4\uC758 \uBC18\uBCF5\uC73C\uB85C
      \uC778\uD55C \uC6A9\uC758\uC790\uC758 \uC2EC\uBB38 \uAC70\uBD80.\n3\uBC88 \uC774\uC0C1\uC758
      <\uAC15\uC555 \uC120\uD0DD\uC9C0> \uC120\uD0DD \uC2DC \uACBD\uACE0 \uD31D\uC5C5,
      4\uBC88 \uC774\uC0C1 \uC120\uD0DD \uC2DC\uC5D0\uB294 \uC794\uC5EC \uD0C0\uC784
      \uD1A0\uD070\uC758 \uAC2F\uC218\uC640 \uC0C1\uAD00 \uC5C6\uC774, \uC6A9\uC758\uC790\uAC00
      \uACF5\uD3EC \uBC0F \uC2E4\uC2E0\uC73C\uB85C \uC778\uD55C \uC2EC\uBB38 \uAC70\uBD80
      \uBC0F \uBD88\uAC00 \uD310\uC815\uC774 \uB098\uD0C0\uB09C\uB2E4.\n\uC2EC\uBB38
      \uD398\uC774\uC988\uC758 \uC2DC\uC791 \uC774\uD6C4\uC5D0 \uBA54\uC778 \uC120\uD0DD\uC9C0\uAC00
      \uC544\uB2CC, <\uC2EC\uBB38 \uC624\uBE0C\uC81D\uD2B8>\uC758 \uC120\uD0DD\uB9CC
      3\uBC88 \uC774\uC0C1 \uBC18\uBCF5 \uB420 \uC2DC, \uC6A9\uC758\uC790\uC758 \uC758\uBB38
      \uD639\uC740 \uBD88\uCF8C\uC5D0 \uB300\uD55C \uBC18\uC751\uACFC \uD568\uAED8
      \uACBD\uACE0 \uD31D\uC5C5\uC774 \uB098\uD0C0\uB098\uBA70, 4\uBC88 \uC774\uC0C1
      \uC120\uD0DD \uC2DC \uC794\uC5EC \uD0C0\uC784 \uD1A0\uD070\uC758 \uAC2F\uC218\uC640
      \uC0C1\uAD00 \uC5C6\uC774, \uC6A9\uC758\uC790\uC758 \uBD84\uB178\uC5D0 \uB300\uD55C
      \uBC18\uC751\uACFC \uD568\uAED8 \uC2EC\uBB38 \uAC70\uBD80 \uBC0F \uBD88\uAC00
      \uD310\uC815\uC774 \uB098\uD0C0\uB09C\uB2E4."
    - "\uBE44\uC815\uC0C1\uC801\uC778 \uC120\uD0DD\uC9C0 \uC120\uD0DD\uC758 \uC591\uC0C1\uC73C\uB85C
      \uC778\uD55C \uAC8C\uC784\uC624\uBC84 (\uD1B5\uC0C1 \uAC8C\uC784\uC624\uBC84
      \uC5D4\uB529)\n\n\uBE44\uC815\uC0C1\uC801\uC778 \uC120\uD0DD\uC9C0 \uC120\uD0DD
      \uC591\uC0C1\uC758 \uAE30\uC900\uC740 2\uBC88 \uC774\uC0C1\uC758 <\uCE5C\uADFC
      \uC120\uD0DD\uC9C0>\uC640 <\uAC15\uC555 \uC120\uD0DD\uC9C0>\uB97C \uAD50\uCC28
      \uC120\uD0DD \uC2DC \uC774\uB8E8\uC5B4\uC9C4\uB2E4.\n1\uBC88 \uC9F8 \uAD50\uCC28
      \uC120\uD0DD \uC2DC, \uC6A9\uC758\uC790\uC758 \uC758\uBB38 \uBC0F \uB2F9\uD669\uC5D0
      \uB300\uD55C \uBC18\uC751\uC774 \uB098\uD0C0\uB09C\uB2E4. \n2\uBC88 \uC9F8
      \uAD50\uCC28 \uC120\uD0DD \uC2DC, \uC6A9\uC758\uC790\uC758 \uBD84\uB178 \uD639\uC740
      \uB2F9\uD639\uC5D0 \uB300\uD55C \uBC18\uC751\uACFC \uD568\uAED8 \uAC8C\uC784\uC624\uBC84
      \uB41C\uB2E4."
    - "\uBB34\uBC18\uC751 \uD310\uC815\uC740 \uC2E4\uC81C \uD604\uC2E4\uC5D0\uC11C\uC758
      \uC2DC\uAC04 \uD750\uB984\uACFC \uC0C1\uD638 \uC791\uC6A9\uB418\uC5B4 \uD310\uC815\uC774
      \uC774\uB8E8\uC5B4\uC9C4\uB2E4.\n\n\uBB34\uBC18\uC751\uC5D0 \uB300\uD55C \uC2DC\uAC04
      \uD0C0\uC774\uBA38 \uD310\uC815\uC740 \uB2E4\uC74C\uACFC \uAC19\uC740 \uD589\uB3D9\uC73C\uB85C
      \uC77C\uC2DC \uC815\uC9C0 \uBC0F \uCD08\uAE30\uD654 \uD560 \uC218 \uC788\uB2E4.\n\xB7
      \uC120\uD0DD\uC9C0 \uC120\uD0DD&\uC7AC\uC120\uD0DD \uD6C4 \uB300\uD654 \uC9C4\uD589
      - \uD0C0\uC774\uBA38 \uCD08\uAE30\uD654\n\xB7 \uC2EC\uBB38 \uC624\uBE0C\uC81D\uD2B8
      \uC120\uD0DD \uD6C4 \uB300\uD654 \uC9C4\uD589 \uBC0F \uD14D\uC2A4\uD2B8 \uCD9C\uB825
      - \uD0C0\uC774\uBA38 \uCD08\uAE30\uD654 \n\xB7 \uAC8C\uC784 \uC77C\uC2DC \uC815\uC9C0
      - \uD0C0\uC774\uBA38 \uC77C\uC2DC \uC815\uC9C0\n\xB7 \uB2E8\uC11C \uD234\uD301
      \uD31D\uC5C5 \uC2DC - \uD14D\uC2A4\uD2B8 \uCD9C\uB825 \uC911 \uBC0F \uCD9C\uB825
      \uC774\uD6C4 1~20\uCD08 \uAC04 \uD0C0\uC774\uBA38 \uC77C\uC2DC \uC815\uC9C0\n\n>>
      \uCD5C\uC885\uC801\uC73C\uB85C \uC218\uB3D9\uC73C\uB85C \uD398\uC774\uC988\uB97C
      \uC885\uB8CC\uC2DC\uD0A4\uAC70\uB098, \uD574\uB2F9 \uC6A9\uC758\uC790 \uCE90\uB9AD\uD130
      \uB9C8\uB2E4 \uD560\uB2F9\uB41C \uD0C0\uC784 \uD1A0\uD070\uC744 \uC804\uBD80
      \uC18C\uC9C4\uD558\uAC8C \uB420 \uC2DC, \uD574\uB2F9 \uC6A9\uC758\uC790 \uCE90\uB9AD\uD130\uC758
      \uD398\uC774\uC988\uAC00 \uC790\uB3D9\uC73C\uB85C \uB9C8\uBB34\uB9AC\uB41C\uB2E4.
      \n>> \uD0C0\uC784 \uD1A0\uD070\uC758 \uC18C\uC9C4\uC73C\uB85C \uC778\uD574
      \uD2B9\uC815 \uB2E8\uC11C\uB098 \uC8FC\uC694 \uC99D\uC5B8 \uB4F1\uC744 \uBABB
      \uB4E3\uAC8C \uB420 \uC218 \uC788\uC73C\uBA70, \uC774 \uACBD\uC6B0\uC5D0\uB294
      \uCD5C\uC885\uC801\uC73C\uB85C \uAC8C\uC784 \uC624\uBC84\uB85C \uC774\uC5B4\uC9C0\uAC8C
      \uB41C\uB2E4."
  - id: POPUP_4
    title: "\uB2E8\uC11C \uC870\uD569 \uD398\uC774\uC988 \u2014 \uD29C\uD1A0\uB9AC\uC5BC
      4"
    trigger: 6
    pages:
    - "[\uB2E8\uC11C \uC870\uD569 \uD398\uC774\uC988]\uC5D0\uC11C\uB294 \uC6B0\uCE21
      \uBAA9\uB85D\uC758 [\uBB3C\uD488 \uC99D\uAC70] \uD558\uB098\uC640 [\uC815\uD669
      \uC99D\uAC70] \uD558\uB098\uB97C \uACE8\uB77C \uC787\uC2B5\uB2C8\uB2E4. \uB450
      \uB2E8\uC11C\uAC00 \uC774\uC5B4\uC9C0\uBA74 \u3008\uAC00\uC124\u3009\uC774
      \uB418\uC5B4 \uC6B0\uCE21 \uC544\uB798\uC758 [\uAC00\uC124] \uCE78\uC5D0 \uC800\uC7A5\uB429\uB2C8\uB2E4.\n\n>>\uBB3C\uD488
      \uCE78\uACFC \uC815\uD669 \uCE78\uC744 \uD55C \uBC88\uC529 \uB204\uB974\uACE0,
      \uBB34\uB300 \uAC00\uC6B4\uB370\uC758 [\uAC00\uC124 \uB3C4\uCD9C]\uC744 \uB204\uB974\uC138\uC694."
    - "[\uAC00\uC124 \uB3C4\uCD9C]\uC744 \uB204\uB97C \uB54C\uB9C8\uB2E4 \uC0C1\uB2E8\uC758
      [\uC789\uD06C]\uAC00 \uD55C \uBC29\uC6B8 \uB9C8\uB985\uB2C8\uB2E4 \u2014 \uC131\uACF5\uD574\uB3C4,
      \uC2E4\uD328\uD574\uB3C4. \uC789\uD06C\uB294 4\uBC88\uC758 \uC2DC\uB3C4\uC785\uB2C8\uB2E4.
      \uAD00\uACC4\uC5C6\uB294 \uB450 \uB2E8\uC11C\uB97C \uC774\uC73C\uBA74 \uC2E4\uD328\uD558\uACE0
      \uAC00\uC124\uC744 \uC5BB\uC9C0 \uBABB\uD569\uB2C8\uB2E4. \uC789\uD06C\uAC00
      \uB2E4 \uB9C8\uB978 \uCC44 \uAC00\uC124\uC774 \uD558\uB098\uB3C4 \uC5C6\uC73C\uBA74
      [\uAC8C\uC784 \uC624\uBC84]\uAC00 \uB429\uB2C8\uB2E4.\n\n>>\uAC00\uC124\uC740
      \uCD5C\uB300 2\uAC1C(\uD29C\uD1A0\uB9AC\uC5BC)\uAE4C\uC9C0 \uC800\uC7A5\uB429\uB2C8\uB2E4.
      \uAC00\uB4DD \uCC2C \uCC44 \uC0C8 \uAC00\uC124\uC774 \uC0DD\uAE30\uBA74 \uAE30\uC874
      \uAC00\uC124 \uD558\uB098\uB97C \uC9C0\uC6B0\uACE0 \uC800\uC7A5\uD569\uB2C8\uB2E4.
      \uAC00\uC124\uC774 \uD558\uB098\uB77C\uB3C4 \uC788\uC73C\uBA74 [\uCD94\uB9AC\uB97C
      \uB9C8\uCE5C\uB2E4]\uB85C \uB118\uC5B4\uAC08 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
  - id: POPUP_4B
    title: "\uC789\uD06C\uC640 \uC2E4\uD328"
    trigger: 7
    pages:
    - "\uC774\uBBF8 \uC774\uC5B4 \uBCF8 \uC9DD\uC740 [\uAC00\uC124 \uB3C4\uCD9C]\uC774
      \uB20C\uB9AC\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4. \uB0A8\uC740 \uC789\uD06C\uB9CC\uD07C\uB9CC
      \uB354 \uC774\uC5B4 \uBCFC \uC218 \uC788\uC2B5\uB2C8\uB2E4.\n\n>>2\uCC28 \uC2EC\uBB38\uC5D0\uC11C\uB294
      \uC778\uBB3C\uB9C8\uB2E4 \uAC00\uC124 \uD558\uB098\uB97C \uB4E4\uACE0 \uB4E4\uC5B4\uAC00\uACE0,
      \uC9C0\uBAA9\uC5D0\uC11C\uB294 \uAC00\uC124\uACFC \uC6A9\uC758\uC790\uB97C
      \uACE8\uB77C \uCD94\uB860\uC744 \uC138\uC6C1\uB2C8\uB2E4. \uC5B4\uB5A4 \uAC00\uC124\uC744
      \uB0A8\uAE38\uC9C0\uAC00 \uACE7 \uC5B4\uB5A4 \uB2F5\uC744 \uB0BC \uC218 \uC788\uC744\uC9C0\uC785\uB2C8\uB2E4."
