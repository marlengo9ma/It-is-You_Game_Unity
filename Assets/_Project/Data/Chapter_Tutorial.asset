        expression: 3
        blurredFromRecallDepth: 2
      autoGrantClueId: 
    - speaker: 0
      text: "\uB2F9\uC2E0\uC740 \uBCF5\uB3C4\uB97C \uD1B5\uD574 \uAC1D\uC2E4 \uBC29\uD5A5\uC73C\uB85C
        \uAC78\uC5B4\uAC00\uBA70 \uC55E\uC120 \uC0AC\uAC74\uAE4C\uC9C0 \uD568\uAED8
        \uD588\uC5C8\uB358, \uB9D0\uC8FC\uBCC0\uC740 \uC5C6\uC9C0\uB9CC \uC77C\uC5D0\uB294
        \uC5F4\uC815\uC774 \uB118\uCCE4\uB358 \uC804 \uBCF4\uC870 \uC218\uC0AC\uAD00\uC744
        \uC0DD\uAC01\uD588\uB2E4."
      expression: 0
      stageDirection: 
      reaction:
        clueId: 
        openDelay: 0
        window: 2.5
        expression: 3
        blurredFromRecallDepth: 2
      autoGrantClueId: 
    - speaker: 0
      text: "\uADF8\uB294 \uBC14\uB85C \uC774\uC804 \uC0AC\uAC74\uC5D0\uC11C \uC2EC\uBB38
        \uB3C4\uC911\uC5D0 \uB3C4\uC8FC\uD558\uB824\uB358 \uC6A9\uC758\uC790\uB97C
        \uCD94\uC801\uD558\uB294 \uB3C4\uC911, \uB9C8\uCC28\uC5D0 \uCE58\uC5EC \uBD80\uC0C1\uC744
        \uC785\uAC8C \uB418\uC5C8\uB2E4."
      expression: 0
      stageDirection: 
      reaction:
        clueId: 
        openDelay: 0
        window: 2.5
        expression: 3
        blurredFromRecallDepth: 2
      autoGrantClueId: 
    - speaker: 0
      text: "\uBCF8\uBD80\uC5D0\uC11C\uB294 \uADF8\uB7F0 \uADF8\uB97C \uB300\uC2E0\uD558\uC5EC,
        \uC544\uAE4C\uC758 \uC18C\uB140\uB97C \uB2F9\uC2E0\uC758 \uBCF4\uC870 \uC218\uC0AC\uAD00\uC73C\uB85C
        \uBC30\uCE58\uD574 \uC8FC\uC5C8\uACE0, \uD568\uAED8 \uC774 \uAE30\uCC28\uC5D0
