  intro:
    note: "\uC0AC\uAC74 \uC9C4\uD589 #1 \u2014 \uC0AC\uB77C\uC9C4 \uB9CC\uB144\uD544"
    lines:
    - speaker: 1
      text: "\u2026\uADF8\uB798\uC11C \uC774\uAC8C \uBB34\uC2A8 \uC77C\uC774\uC8E0?"
      expression: 0
      stageDirection: 
      reaction:
        clueId: 
        openDelay: 0
        window: 2.5
        expression: 3
        blurredFromRecallDepth: 2
      autoGrantClueId: 
    - speaker: 0
      text: "\uB2F9\uC2E0\uC740 \uB2E4\uC18C \uC5C9\uB9DD\uC774 \uB41C \uD14C\uC774\uBE14\uACFC
        \uC8FC\uBCC0 \uBC14\uB2E5, \uADF8\uB9AC\uACE0 \uC5B4\uC9C8\uB7EC\uC9C4 \uC8FC\uBCC0\uC744
        \uC815\uB3C8\uD558\uBA70 \uC77C\uBD80\uB85C \uB2F9\uC2E0\uC758 \uB208\uC744
        \uD53C\uD558\uB294 \uB4EF\uD55C \uC18C\uB140\uC640, \uC65C \uC778\uC9C0\uB294
        \uBAA8\uB974\uACA0\uC9C0\uB9CC \uD14C\uC774\uBE14 \uC704\uC5D0\uC11C \uB9CC\uC871\uC2A4\uB7EC\uC6B4
        \uD45C\uC815\uC73C\uB85C \uC2DD\uBE75\uC744 \uAD7D\uACE0 \uC788\uB294 \uAC80\uC740
        \uACE0\uC591\uC774 \uD55C \uB9C8\uB9AC\uB97C \uB9C8\uC8FC\uD588\uB2E4."
      expression: 0
      stageDirection: 
      reaction:
        clueId: 
        openDelay: 0
        window: 2.5
        expression: 3
        blurredFromRecallDepth: 2
      autoGrantClueId: 
    - speaker: 3
      text: "\uD558\uD558\u2026 \uC5B4\uC11C \uC624\uC138\uC694, \uC218\uC0AC\uAD00\uB2D8.
        \uAE08\uBC29 \uC815\uB9AC\uD560\uAC8C\uC694. \uC870\uAE08\uB9CC \uAE30\uB2E4\uB824\uC8FC\uC138\uC694!"
      expression: 2
      stageDirection: 
      reaction:
        clueId: 
        openDelay: 0
        window: 2.5
        expression: 3
        blurredFromRecallDepth: 2
      autoGrantClueId: 
    - speaker: 4
      text: "\uC6E8\uC639."
      expression: 0
      stageDirection: 
      reaction:
        clueId: 
        openDelay: 0
        window: 2.5
        expression: 3
        blurredFromRecallDepth: 2
      autoGrantClueId: 
    - speaker: 0
      text: "\uC544\uBB34\uB798\uB3C4 \uC774 \uB09C\uC7A5\uD310\uC774 \uB41C \uC0C1\uD669\uC740
        \uC800 \uACE0\uC591\uC774\uC758 \uB4F1\uC7A5\uACFC \uC5F0\uAD00\uC774 \uC788\uACA0\uAC70\uB2C8
        \uC2F6\uC5B4\uBCF4\uC600\uB2E4."
      expression: 0
      stageDirection: 
      reaction:
        clueId: 
        openDelay: 0
        window: 2.5
        expression: 3
        blurredFromRecallDepth: 2
      autoGrantClueId: 
    - speaker: 0
      text: "\uB2F9\uC2E0\uC740 \uBC84\uB987\uCC98\uB7FC \uBBF8\uAC04\uC744 \uBB38\uC9C0\uB974\uBA70,
        \uC18C\uB140\uB97C \uB3C4\uC640 \uC790\uB9AC\uB97C \uC815\uB3C8\uD558\uAE30
        \uC2DC\uC791\uD588\uB2E4."
      expression: 0
      stageDirection: 
      reaction:
        clueId: 
        openDelay: 0
        window: 2.5
        expression: 3
        blurredFromRecallDepth: 2
      autoGrantClueId: 
    - speaker: 2
      text: "\uC785 \uBC16\uC73C\uB85C\uB3C4 \uAEBC\uB0C8\uC73C\uBA74 \uC548 \uB418\uB294
        \uAC70\uC600\uB098."
