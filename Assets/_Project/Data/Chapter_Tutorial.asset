  id: CH_TUTORIAL
  displayName: "\uD29C\uD1A0\uB9AC\uC5BC \u2014 \uB204\uAC00 \uADF8\uB7AC\uC9C0?"
  isTutorial: 1
  preIncidentTalk:
    note: "\uC0AC\uAC74 \uC774\uC804 \u2014 \uAC1D\uC2E4"
    lines:
    - speaker: 0
      text: "\uAE30\uCC28\uC5D0 \uC62C\uB77C\uD0C0\uACE0 \uC57D\uAC04\uC758 \uC2DC\uAC04\uC774
        \uD750\uB978 \uB4A4, \uB2F9\uC2E0\uC740 \uB2E4\uC18C \uD6C4\uD68C\uC2A4\uB7EC\uC6B4
        \uC5BC\uAD74\uC744 \uD558\uACE0 \uC788\uB2E4."
      expression: 0
      stageDirection: 
      reaction:
        clueId: 
        openDelay: 0
        window: 2.5
        expression: 3
        blurredFromRecallDepth: 2
      autoGrantClueId: 
    - speaker: 0
      text: "\uC18C\uB140\uB294 \uB2F9\uC2E0\uC758 \uC120\uBB3C\uC774 \uB9C8\uC74C\uC5D0
        \uB4E4\uC5C8\uB294\uC9C0 \uD734\uB300\uC6A9 \uD0C0\uC790\uAE30\uB97C \uACC4\uC18D
        \uB450\uB4E4\uAE30\uBA70 \uC870\uC798 \uC870\uC798 \uB5A0\uB4E4\uACE0 \uC788\uB2E4.
        \uB2F9\uC2E0\uC758 \uD589\uB3D9\uC73C\uB85C \uC778\uD574 \uAE34\uC7A5\uC774
        \uD480\uB824 \uAC70\uB9AC\uAC10\uC774 \uAC00\uAE4C\uC6CC\uC84C\uAC70\uB098,
        \uBCF8\uB798 \uC774\uB7F0 \uC131\uACA9\uC774\uAC70\uB098, \uB458 \uC911 \uD558\uB098\uC784\uC740
        \uBD84\uBA85\uD558\uB2E4."
      expression: 0
      stageDirection: 
      reaction:
        clueId: 
        openDelay: 0
        window: 2.5
        expression: 3
        blurredFromRecallDepth: 2
      autoGrantClueId: 
    - speaker: 3
      text: "\u2026\uADF8\uB798\uC11C \uBCF8\uBD80 \uAE30\uB85D\uC5D0\uB294 \uC218\uC0AC\uAD00\uB2D8\uC774
        \uC644\uC804 \uBB34\uC12D\uAC8C \uBB18\uC0AC\uB418\uC5B4 \uC788\uB354\uB77C\uACE0\uC694!
        \uC120\uBC30\uB2D8\uB4E4\uC774 \uB0A8\uAE34 \uAE30\uB85D\uC744 \uBCF4\uBA74,
        \uC218\uC0AC\uD560 \uB54C \uC0AC\uB78C\uC774 180\uB3C4\uC529 180\uBC88 \uBC14\uB010\uB2E4\uBA74\uC11C\uC694?
        \uC545\uB839\uC774 \uC50C\uC5C8\uB2E4\uB294 \uC18C\uBB38\uB3C4 \uC788\uACE0,
        \uC2EC\uBB38\uD560 \uB54C\uB294 \uC0C1\uB0E5\uD558\uB2E4\uAC00 \uAC11\uC790\uAE30
        \uC18C\uB9AC\uB97C \uC9C8\uB7EC\uC11C \uC6A9\uC758\uC790\uAC00 \uAE30\uC808\uD55C
        \uC801\uB3C4 \uD55C\uB450 \uBC88\uC774 \uC544\uB2C8\uB77C\uBA74\uC11C\uC694! "
      expression: 1
      stageDirection: 
      reaction:
        clueId: 
        openDelay: 0
        window: 2.5
        expression: 3
        blurredFromRecallDepth: 2
      autoGrantClueId: 
    - speaker: 1
      text: "\u2026"
      expression: 0
      stageDirection: 
      reaction:
        clueId: 
        openDelay: 0
        window: 2.5
        expression: 3
        blurredFromRecallDepth: 2
      autoGrantClueId: 
    - speaker: 0
      text: "\uB2F9\uC2E0\uC740 \uC18C\uB140\uC758 \uC870\uC798\uAC70\uB9BC\uC5D0
        \uC9C8\uB824\uAC00\uBA74\uC11C\uB3C4 \uC804 \uD30C\uD2B8\uB108\uAC00 \uBCF5\uADC0\uD558\uBA74
        \uC4F4\uC18C\uB9AC\uB97C \uC880 \uD574\uC57C\uACA0\uB2E4\uACE0 \uB9C8\uC74C
        \uBA39\uB294\uB2E4."
      expression: 0
      stageDirection: 
      reaction:
        clueId: 
        openDelay: 0
        window: 2.5
        expression: 3
        blurredFromRecallDepth: 2
      autoGrantClueId: 
    - speaker: 3
      text: "\uADF8\uB7F0\uB370 \uC774\uAC8C \uBB34\uC2A8 \uC77C! \uBB34\uB69D\uB69D\uD55C
        \uB4EF \uBCF4\uC774\uC9C0\uB9CC \uC0AC\uC2E4\uC740 \uC774\uB807\uAC8C \uC13C\uC2A4\uB118\uCE58\uACE0
        \uADC0\uC5EC\uC6B4 \uC120\uBB3C\uC744 \uC900\uBE44\uD574\uC8FC\uC2DC\uB294
        \uB9C8\uC74C \uB530\uB4EF\uD55C \uC218\uC0AC\uAD00\uB2D8\uC774\uC168\uC744
        \uC904\uC740 \uBAB0\uB790\uC9C0 \uBB50\uC608\uC694?"
      expression: 1
      stageDirection: 
      reaction:
        clueId: 
        openDelay: 0
        window: 2.5
        expression: 3
        blurredFromRecallDepth: 2
      autoGrantClueId: 
    - speaker: 1
      text: "\u2026\uADF8\uB9CC. \uC7A0\uC2DC \uC77C \uC880 \uBCF4\uACE0 \uC624\uACA0\uC2B5\uB2C8\uB2E4."
      expression: 0
      stageDirection: 
      reaction:
        clueId: 
        openDelay: 0
        window: 2.5
        expression: 3
        blurredFromRecallDepth: 2
      autoGrantClueId: 
    - speaker: 3
      text: "..\uD07C\uD07C, \uB124~"
      expression: 2
      stageDirection: 
      reaction:
        clueId: 
        openDelay: 0
        window: 2.5
        expression: 3
        blurredFromRecallDepth: 2
      autoGrantClueId: 
    - speaker: 0
      text: "\uB2F9\uC2E0\uC740 \uAC04\uC9C0\uB7EC\uC6B4 \uBD84\uC704\uAE30\uB97C
        \uC774\uAE30\uC9C0 \uBABB \uD558\uACE0 \uAE09\uD558\uAC8C \uC790\uB9AC\uC5D0\uC11C
        \uC77C\uC5B4\uB0AC\uB2E4. \uADF8\uB7F0 \uBD84\uC704\uAE30\uB97C \uB290\uAF08\uB294\uC9C0,
        \uC18C\uB140\uB3C4 \uC870\uAE08\uC740 \uC9C4\uC815\uD558\uB824\uB294 \uAC83\uCC98\uB7FC
        \uC790\uC2E0\uC758 \uC637\uB9E4\uBB34\uC0C8\uB97C \uB2E4\uB4EC\uC73C\uBA70
        \uBC1C\uB784\uD558\uAC8C \uB300\uB2F5\uD55C\uB2E4."
      expression: 0
      stageDirection: 
      reaction:
        clueId: 
        openDelay: 0
        window: 2.5
        expression: 3
        blurredFromRecallDepth: 2
      autoGrantClueId: 
    trustDelta: 0
    endsInterrogation: 0
  cutsceneName: "\uC77C\uB7EC\uC2A4\uD2B8 \uCEF7\uC52C#1 \u2014 \uC8FC\uC778\uACF5
    \uB3C5\uBC31"
  cutsceneImage: {fileID: 21300000, guid: c84105da763069d4290e77ebfe3baff3, type: 3}
  cutscene:
    note: "\uC77C\uB7EC\uC2A4\uD2B8 \uCEF7\uC52C#1 \u2014 \uC8FC\uC778\uACF5 \uB3C5\uBC31"
    lines:
    - speaker: 2
      text: "\u2026"
      expression: 0
      stageDirection: 
      reaction:
        clueId: 
        openDelay: 0
        window: 2.5
        expression: 3
        blurredFromRecallDepth: 2
      autoGrantClueId: 
    - speaker: 0
      text: "\uB2F9\uC2E0\uC740 \uAE30\uCC28 \uB0B4\uC758 \uD654\uC7A5\uC2E4 \uCE78\uC73C\uB85C
        \uD5A5\uD558\uACE0, \uC774\uB0B4 \uC138\uBA74\uB300\uC758 \uAC70\uC6B8 \uC55E\uC5D0
        \uC11C\uC11C \uD55C\uC228\uC744 \uB0B4\uC270\uB2E4. \uB2F9\uC2E0\uC740 \uC0AC\uC2E4
        \uC18C\uB140\uAC00 \uAC00\uC9C4 \uB2A5\uB825\uC5D0 \uB300\uD574 \uC57D\uAC04\uC758
        \uC758\uAD6C\uC2EC\uC744 \uD488\uACE0 \uC788\uB2E4. \uC9C0\uB098\uCE58\uAC8C
        \uC5B4\uB9B0 \uB098\uC774\uC5D0 \uD604\uC7A5\uC5D0 \uBC1C\uB839\uB41C \uAC83\uC73C\uB85C\uB3C4
        \uBAA8\uC790\uB77C, \uC18C\uB140\uAC00 \uAC00\uC9C4 \uC774\uB825 \uC5ED\uC2DC
        \uACFC\uD558\uAC8C \uBD80\uD480\uB824\uC84C\uB2E4\uACE0 \uB290\uAF08\uAE30
        \uB54C\uBB38\uC774\uB2E4."
      expression: 0
      stageDirection: 
      reaction:
        clueId: 
        openDelay: 0
        window: 2.5
        expression: 3
        blurredFromRecallDepth: 2
      autoGrantClueId: 
    - speaker: 0
      text: "\uD2B9\uD788 \uD2B9\uAE30\uB780\uC5D0 \uC801\uD600\uC788\uB358 \u2018\uC21C\uAC04
        \uAE30\uC5B5 \uB2A5\uB825\u2019 \uC5D0 \uACF5\uC778\uAE4C\uC9C0 \uBD99\uC5B4\uC788\uB294
        \uACBD\uC6B0\uB294 \uB2F9\uC2E0\uC73C\uB85C\uC11C\uB3C4 \uCC98\uC74C \uBCF4\uB294
        \uAC83\uC774\uB2E4."
      expression: 0
      stageDirection: 
      reaction:
        clueId: 
        openDelay: 0
        window: 2.5
        expression: 3
        blurredFromRecallDepth: 2
      autoGrantClueId: 
    - speaker: 2
      text: "\uBB34\uC5B8\uAC00 \uB192\uC740 \uC0AC\uB78C\uC758 \uB4B7\uBC30\uB77C\uB3C4
        \uC788\uB294 \uAC74\uAC00?"
      expression: 0
      stageDirection: 
      reaction:
        clueId: 
        openDelay: 0
        window: 2.5
        expression: 3
        blurredFromRecallDepth: 2
      autoGrantClueId: 
    - speaker: 0
      text: "\uCDA9\uBD84\uD788 \uC788\uC744 \uB9CC\uD55C \uC774\uC57C\uAE30\uC774\uB2E4."
      expression: 0
      stageDirection: 
      reaction:
        clueId: 
        openDelay: 0
        window: 2.5
        expression: 3
        blurredFromRecallDepth: 2
      autoGrantClueId: 
    - speaker: 0
      text: "\uD558\uC9C0\uB9CC \uC11C\uB958\uC0C1\uC774\uB77C\uBA74 \uBAA8\uB97C\uAE4C,
        \uC2E4\uC81C \uC0AC\uAC74 \uD604\uC7A5\uC5D0\uC11C\uB294 \uD5C8\uC704 \uAE30\uC7AC\uB294
        \uC5C4\uC5F0\uD55C \uC9D5\uACC4\uB300\uC0C1\uC774\uC790, \uD655\uC2E4\uD788
        \uD558\uC9C0 \uC54A\uC73C\uBA74 \uB3C4\uB9AC\uC5B4 \uC704\uD5D8\uC694\uC18C\uAC00
        \uB420 \uC218 \uC788\uAE30\uC5D0 \uC774\uB294 \uC808\uB300\uB85C \uC788\uC5B4\uC11C\uB294
        \uC548 \uB418\uB294 \uC77C\uC774\uB2E4."
      expression: 0
      stageDirection: 
      reaction:
        clueId: 
        openDelay: 0
        window: 2.5
        expression: 3
        blurredFromRecallDepth: 2
      autoGrantClueId: 
    - speaker: 1
      text: "\u2026\uC774\uB984\uC774 \uBB50\uB77C\uACE0 \uD588\uC9C0? \uC138\uB77C?"
      expression: 0
      stageDirection: 
      reaction:
        clueId: 
        openDelay: 0
        window: 2.5
        expression: 3
        blurredFromRecallDepth: 2
      autoGrantClueId: 
    - speaker: 0
      text: "\uB2F9\uC7A5\uC740 \uC11C\uB958\uAC00 \uC5C6\uC73C\uB2C8 \uD655\uC778
        \uD560 \uBC29\uB3C4\uB294 \uC5C6\uC9C0\uB9CC \uC660\uC9C0 \uC785\uC5D0 \uC798
        \uC548 \uBD99\uC740 \uC774\uB984\uC774\uC600\uB2E4."
      expression: 0
      stageDirection: 
      reaction:
        clueId: 
        openDelay: 0
        window: 2.5
        expression: 3
        blurredFromRecallDepth: 2
      autoGrantClueId: 
    - speaker: 1
      text: "\uBB50, \uC815 \uC548 \uB418\uBA74 \uD604\uC7A5\uC5D0\uC11C \uC778\uB825
        \uAD50\uCCB4 \uC694\uCCAD\uC744 \uD558\uBA74 \uB418\uB2C8."
      expression: 0
      stageDirection: 
      reaction:
        clueId: 
        openDelay: 0
        window: 2.5
        expression: 3
        blurredFromRecallDepth: 2
      autoGrantClueId: 
    - speaker: 0
      text: "\u2018\uADF8 \uC815\uB3C4\uC57C \uBB50, \uD55C \uBC88\uCBE4\uC740 \uAD1C\uCC2E\uACA0\uC9C0.\u2019
        \uC0DD\uAC01\uD558\uBA70 \uB2F9\uC2E0\uC740 \uC637\uB9E4\uBB34\uC0C8\uB97C
        \uB2E4\uB4EC\uC740 \uB4A4 \uC790\uB9AC\uB85C \uB3CC\uC544\uAC08 \uCC44\uBE44\uB97C
        \uB9C8\uCCE4\uB2E4."
      expression: 0
      stageDirection: 
      reaction:
        clueId: 
        openDelay: 0
        window: 2.5
        expression: 3
        blurredFromRecallDepth: 2
      autoGrantClueId: 
    - speaker: 0
      text: "\uBB3C\uB860 \uC774\uB7F0 \uC5EC\uC720\uB294 \uB2F9\uC5F0\uD558\uB2E4.
        \uB2F9\uC2E0\uC740 \uC774 \uC2DC\uB300\uC5D0 \uAC00\uC7A5 \uAC01\uAD11 \uBC1B\uB294
        \uC9C1\uC5C5\uC744 \uAC00\uC9C4 \uC0AC\uB78C\uC774\uB2C8\uAE4C."
      expression: 0
      stageDirection: 
      reaction:
        clueId: 
        openDelay: 0
        window: 2.5
        expression: 3
        blurredFromRecallDepth: 2
      autoGrantClueId: 
    - speaker: 0
      text: "\u2018\uD45C\uC815 \uC2EC\uB9AC \uC218\uC0AC\uAD00\u2018."
      expression: 0
      stageDirection: 
      reaction:
        clueId: 
        openDelay: 0
        window: 2.5
        expression: 3
        blurredFromRecallDepth: 2
      autoGrantClueId: 
    - speaker: 0
      text: "\uD604\uC7AC \uB2F9\uC2E0\uC774 \uAC00\uC9C4 \uC9C1\uC5C5\uC774\uC790,
        \uCD5C\uADFC \uC0C8\uB86D\uAC8C \uB9CC\uB4E4\uC5B4\uC9C4 \uC218\uC0AC \uAE30\uBC95\uC778
        \u2018\uD45C\uC815 \uD589\uB3D9 \uD574\uBD80\uD559\u2019 \uC744 \uC8FC\uB825\uC73C\uB85C
        \uAC01\uC885 \uC0AC\uAC74\uC5D0 \uB300\uD55C \uC218\uC0AC\uB97C \uC9C4\uD589\uD558\uB294
        \uD2B9\uC218 \uC9C1\uC5C5\uC774\uB2E4."
      expression: 0
      stageDirection: 
      reaction:
        clueId: 
        openDelay: 0
        window: 2.5
        expression: 3
        blurredFromRecallDepth: 2
      autoGrantClueId: 
    - speaker: 0
      text: "\uCD5C\uADFC \uAE09\uC99D\uD558\uB294 \uC2E0\uC885 \uBC94\uC8C4\uC5D0
        \uB9DE\uC11C\uAE30 \uC704\uD574 \uB2E4\uC591\uD55C \uC2E4\uD5D8\uC801 \uAE30\uBC95\uC744
        \uC2DC\uB3C4\uD558\uB294 \uC218\uC0AC\uD300\uC774 \uAFB8\uB824\uC84C\uACE0,
        \uADF8\uC911 '\uACFC\uD559 \uC218\uC0AC'\uB294 \uB300\uC911\uC5D0\uAC8C '\uC774\uB2E8'\uC73C\uB85C
        \uCDE8\uAE09\uBC1B\uC558\uB2E4. \uC9C0\uBB38\uC774\uB098 \uD608\uD754 \uAC19\uC740
        \uBCF4\uC774\uC9C0 \uC54A\uB294 \uC99D\uAC70\uB294 \uC0AC\uB78C\uB4E4\uC5D0\uAC8C
        \uB9C8\uB140\uC0AC\uB0E5\uCC98\uB7FC \uBD88\uD569\uB9AC\uD558\uAC8C \uB290\uAEF4\uC84C\uB2E4."
      expression: 0
      stageDirection: 
      reaction:
        clueId: 
        openDelay: 0
        window: 2.5
        expression: 3
        blurredFromRecallDepth: 2
      autoGrantClueId: 
    - speaker: 0
      text: "\uBC18\uBA74, '\uD45C\uC815 \uD589\uB3D9 \uD574\uBD80\uD559'\uC740 \uB2EC\uB790\uB2E4.
        \uD0C0\uC778\uC758 \uBBF8\uC138\uD55C \uD45C\uC815\uACFC \uD589\uB3D9\uC744
        \uD1B5\uACC4\uD559\uC801\uC778 \uC218\uCE58\uC640 \uADFC\uAC70\uB85C \uBD84\uC11D\uD558\uC5EC
        \uC790\uBC31\uC744 \uB04C\uC5B4\uB0B4\uB294 \uBC29\uC2DD\uC740 \uC9C1\uAD00\uC801\uC774\uACE0
        \uC124\uB4DD\uB825 \uC788\uC5C8\uB2E4. \uD2B9\uD788, \uC55E\uC11C \uACFC\uD559
        \uC218\uC0AC\uD300\uC774 \uC798\uBABB \uC9C0\uBAA9\uD588\uB358 \uBC94\uC778\uC744
        \uD45C\uC815 \uC218\uC0AC\uB85C \uBC14\uB85C\uC7A1\uC558\uB358 \uC0AC\uAC74\uC740
        \uC774 \uC0C8\uB85C\uC6B4 \uC218\uC0AC \uAE30\uBC95\uC5D0 \uB300\uD55C \uC808\uB300\uC801\uC778
        \uC2E0\uB8B0\uB97C \uAD6C\uCD95\uD588\uB2E4."
      expression: 0
      stageDirection: 
      reaction:
        clueId: 
        openDelay: 0
        window: 2.5
        expression: 3
        blurredFromRecallDepth: 2
      autoGrantClueId: 
    - speaker: 0
      text: "\uADF8\uB807\uAC8C \uB2F9\uC2E0\uCC98\uB7FC \uD0C0\uC778\uC758 \uD45C\uC815\uACFC
        \uD589\uB3D9\uC744 \uC77D\uC5B4\uB0B4\uB294 \uB370 \uCC9C\uBD80\uC801\uC778
        \uC7AC\uB2A5\uC744 \uAC00\uC9C4 \uC774\uB4E4\uC740 \uC5C4\uC911\uD558\uACE0
        \uAE4C\uB2E4\uB85C\uC6B4 \uC120\uBC1C \uACFC\uC815\uC744 \uAC70\uCCD0 '\uD45C\uC815
        \uD589\uB3D9 \uC218\uC0AC\uAD00'\uC73C\uB85C \uC784\uBA85\uB418\uC5C8\uB2E4."
      expression: 0
      stageDirection: 
      reaction:
        clueId: 
        openDelay: 0
        window: 2.5
        expression: 3
        blurredFromRecallDepth: 2
      autoGrantClueId: 
    - speaker: 0
      text: "\uC80A\uC740 \uB098\uC774\uC5D0 \uB192\uC740 \uAC80\uAC70\uC728\uACFC
